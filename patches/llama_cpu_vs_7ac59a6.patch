diff --git a/ggml/src/ggml-cuda/f44.cu b/ggml/src/ggml-cuda/f44.cu
new file mode 100644
index 0000000..3c460ed
--- /dev/null
+++ b/ggml/src/ggml-cuda/f44.cu
@@ -0,0 +1,1186 @@
+// R47 M6: F44 lut36 GEMV hook for llama.cpp (see f44.cuh). Kernel body = k_lut<FMT 0, RL, BUILD 0, MODE 0> of
+// research/kernels/r47_vr.cu / lut36.cu, with the next-buffer zeroing removed (dst is zeroed by a memset node).
+#include "f44.cuh"
+#include "quantize.cuh"
+#include "convert.cuh"
+#include "mmq.cuh"
+#include <vector>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <atomic>
+#include <algorithm>
+#include <mutex>
+#include <string>
+#include <utility>
+
+typedef uint32_t f44_u32;
+// 4 int8 levels L[0..3] = -127, -38, 38, 127 (LEV_REAL of r47_vr.cu)
+static const int F44_LEV4 = (int)((f44_u32)(uint8_t)(int8_t)-127 | (f44_u32)(uint8_t)(int8_t)-38 << 8 |
+                                  (f44_u32)(uint8_t)(int8_t)38 << 16 | (f44_u32)(uint8_t)(int8_t)127 << 24);
+
+struct f44_args { const uint4 * W; const half * S; const block_q8_1 * X; float * y; int rows, nsl, nb32, lev4; };
+
+static __device__ __forceinline__ int f44_sx8(int v, int b) { return (int)(int8_t)(v >> (8 * b)); }
+
+template <int RL>
+static __global__ void __launch_bounds__(256, 3) k_f44_lut(const f44_args a) {
+    __shared__ __align__(16) int T[8192];
+    const int tid = threadIdx.x, lane = tid & 31, w = tid >> 5;
+    const int s = blockIdx.x % a.nsl, rb = blockIdx.x / a.nsl;
+    const int b0 = (rb * 8 + w) * RL;
+    uint4 wv[RL][2];
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int b = b0 + m;
+        if (b < a.nb32) { const uint4 * p = a.W + ((size_t)s * a.nb32 + b) * 64 + lane; wv[m][0] = __ldcs(p); wv[m][1] = __ldcs(p + 32); }
+        else { wv[m][0] = make_uint4(0, 0, 0, 0); wv[m][1] = wv[m][0]; }
+    }
+    {   // BUILD 0 (Pingala prastara / Narayana mixed radix): every table entry = an earlier entry + one term
+        const int t = lane, q = w & 3, p = w >> 2;
+        const f44_u32 x4 = *(const f44_u32 *)&a.X[s * 4 + (t >> 3)].qs[4 * (t & 7)];
+        const int x0 = f44_sx8(x4, 0), x1 = f44_sx8(x4, 1), x2 = f44_sx8(x4, 2), x3 = f44_sx8(x4, 3);
+        int * Tb = T + q * 32 + p * 256 + t;
+        const int L0 = f44_sx8(a.lev4, 0), L1 = f44_sx8(a.lev4, 1), L2 = f44_sx8(a.lev4, 2), L3 = f44_sx8(a.lev4, 3);
+        const int base = f44_sx8(a.lev4, q) * x0;
+        const int A0 = base + f44_sx8(a.lev4, 2 * p) * x1, A1 = base + f44_sx8(a.lev4, 2 * p + 1) * x1;
+        const int P2[4] = {L0 * x2, L1 * x2, L2 * x2, L3 * x2}, P3[4] = {L0 * x3, L1 * x3, L2 * x3, L3 * x3};
+#pragma unroll
+        for (int c2 = 0; c2 < 4; ++c2) {
+            const int B0 = A0 + P2[c2], B1 = A1 + P2[c2];
+#pragma unroll
+            for (int c3 = 0; c3 < 4; ++c3) { Tb[512 * c2 + 2048 * c3] = B0 + P3[c3]; Tb[128 + 512 * c2 + 2048 * c3] = B1 + P3[c3]; }
+        }
+    }
+    __syncthreads();
+    float dx[4];
+#pragma unroll
+    for (int kb = 0; kb < 4; ++kb) dx[kb] = __low2float(a.X[s * 4 + ((lane >> 3) ^ kb)].ds);
+    float facc[RL];
+#pragma unroll
+    for (int m = 0; m < RL; ++m) facc[m] = 0.f;
+    const f44_u32 lane4 = (f44_u32)lane << 2;
+#pragma unroll
+    for (int kb = 0; kb < 4; ++kb) {
+        int iacc[RL];
+#pragma unroll
+        for (int m = 0; m < RL; ++m) iacc[m] = 0;
+#pragma unroll
+        for (int k8 = 0; k8 < 8; ++k8) {
+            const int k = kb * 8 + k8;
+            const f44_u32 off = lane4 ^ (f44_u32)(4 * k);
+#pragma unroll
+            for (int m = 0; m < RL; ++m) {
+                const uint4 v = wv[m][k >> 4]; const int wi = (k >> 2) & 3, i = k & 3;
+                const f44_u32 word = wi == 0 ? v.x : wi == 1 ? v.y : wi == 2 ? v.z : v.w;
+                const f44_u32 sh = i == 0 ? (word << 7) : (word >> (8 * i - 7));
+                iacc[m] += *(const int *)((const char *)T + ((sh & 0x7F80u) | off));
+            }
+        }
+#pragma unroll
+        for (int m = 0; m < RL; ++m) facc[m] = fmaf(dx[kb], (float)iacc[m], facc[m]);
+    }
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int b = b0 + m;
+        if (b < a.nb32) { const int r = b * 32 + lane; atomicAdd(a.y + r, facc[m] * __half2float(a.S[(size_t)(s >> 1) * a.rows + r])); }
+    }
+}
+
+// weight (r, col) of the F44 layout, exact in fp32 (fp16 d_w x int8 level)
+static __device__ __forceinline__ float f44_weight(const uint4 * W, const half * S, int rows, int nsl, int lev4, int r, int col) {
+    const int s = col >> 7, t = (col >> 2) & 31, i = col & 3, nb32 = rows >> 5, lane = r & 31, k = lane ^ t;
+    const uint8_t * p = (const uint8_t *)(W + ((size_t)s * nb32 + (r >> 5)) * 64 + (k >> 4) * 32 + lane);
+    const int c = (p[k & 15] >> (2 * i)) & 3;
+    (void)nsl;
+    return __half2float(S[(size_t)(s >> 1) * rows + r]) * (float)f44_sx8(lev4, c);
+}
+
+template <typename T>
+static __global__ void k_f44_dequant(const uint4 * W, const half * S, T * y, int rows, int K, int lev4) {
+    const size_t idx = (size_t)blockIdx.x * blockDim.x + threadIdx.x;      // one thread = 4 weights (row r, chunk)
+    const int nsl = K >> 7;
+    if (idx >= (size_t)rows * nsl * 32) return;
+    const int t = idx & 31; const size_t rest = idx >> 5; const int s = rest % nsl, r = rest / nsl;
+    const int col = s * 128 + 4 * t;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) y[(size_t)r * K + col + i] = ggml_cuda_cast<T>(f44_weight(W, S, rows, nsl, lev4, r, col + i));
+}
+
+// fp32 reference GEMV on the same q8_1 activations (for GGML_F44_CHECK)
+static __global__ void k_f44_ref(const uint4 * W, const half * S, const block_q8_1 * X, float * y, int rows, int K, int lev4) {
+    const int r = blockIdx.x, lane = threadIdx.x; float acc = 0.f;
+    for (int col = lane; col < K; col += 32) {
+        const block_q8_1 & b = X[col >> 5];
+        acc += f44_weight(W, S, rows, K >> 7, lev4, r, col) * (__low2float(b.ds) * (float)b.qs[col & 31]);
+    }
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+    if (lane == 0) y[r] = acc;
+}
+
+int ggml_cuda_f44_mode() {
+    static const int m = [] { const char * e = getenv("GGML_F44"); const int v = e ? atoi(e) : 0; return v >= 1 && v <= 4 ? v : 0; }();
+    return m;
+}
+bool ggml_cuda_f44_env() { return ggml_cuda_f44_mode() == 1; }   // convert.cu fp16/fp32 dequant swap: F44 only
+
+// R51 native VR (GGML_VR_NATIVE=1; file research/detail/r51_native.py, loader llama-model-loader.cpp vr_native_init/vr_native_load).
+// VR linears sit in the smallest quant slot that holds kernel bytes + side data (IQ2_XXS for 206, Q2_K/Q3_K/Q5_K for 46; ggml-vr-native.h).
+// Non-IQ2_XXS slots are claimed only after prepare_graph found the R51 trailer in them (vr_native_probe), so e.g. the Q5_K LM head is untouched.
+static int vr_native_env() { static const int m = [] { const char * e = getenv("GGML_VR_NATIVE"); return e ? atoi(e) : 0; }(); return m; }
+static bool vr_native_slot(ggml_type t) {   // = llama-model-loader.cpp vr_native_init slots[]
+    return t == GGML_TYPE_IQ2_XXS || t == GGML_TYPE_Q2_K || t == GGML_TYPE_Q3_K || t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K || t == GGML_TYPE_Q6_K;
+}
+static std::mutex g_vrn_mu;
+static std::map<const void *, int> g_vr_native_reg;   // tensor data -> 1 for every probed native VR tensor
+
+bool ggml_cuda_f44_active(const ggml_tensor * src0) {
+    if (!ggml_cuda_f44_mode()) return false;
+    if (src0->type != GGML_TYPE_IQ2_XXS) {
+        if (!vr_native_env() || !vr_native_slot(src0->type)) return false;
+        std::lock_guard<std::mutex> lk(g_vrn_mu);
+        if (!g_vr_native_reg.count(src0->data)) return false;
+    }
+    return src0->ne[0] % 256 == 0 && src0->ne[1] % 32 == 0 && src0->ne[1] <= 65535 && src0->ne[2] == 1 && src0->ne[3] == 1 &&
+           ggml_is_contiguous(src0) && !src0->view_src;
+}
+
+int ggml_cuda_f44_batch_mode() {
+    static const int m = [] { const char * e = getenv("GGML_F44_BATCH"); return e ? atoi(e) : 1; }();
+    return m;
+}
+
+static thread_local int64_t g_f44_ne00 = 0, g_f44_ne01 = 0;
+void ggml_cuda_f44_set_dims(int64_t ne00, int64_t ne01) { g_f44_ne00 = ne00; g_f44_ne01 = ne01; }
+
+template <typename T>
+static void f44_to(const void * x, T * y, int64_t k, cudaStream_t stream) {
+    GGML_ASSERT(g_f44_ne00 > 0 && g_f44_ne00 * g_f44_ne01 == k);
+    const int rows = (int)g_f44_ne01, K = (int)g_f44_ne00;
+    const uint4 * W = (const uint4 *)x; const half * S = (const half *)((const char *)x + (size_t)rows * K / 4);
+    const size_t n = (size_t)rows * (K / 128) * 32;
+    k_f44_dequant<T><<<(unsigned)((n + 255) / 256), 256, 0, stream>>>(W, S, y, rows, K, F44_LEV4);
+    g_f44_ne00 = g_f44_ne01 = 0;
+}
+void ggml_cuda_f44_to_fp16(const void * x, half * y, int64_t k, cudaStream_t stream) { f44_to<half>(x, y, k, stream); }
+void ggml_cuda_f44_to_fp32(const void * x, float * y, int64_t k, cudaStream_t stream) { f44_to<float>(x, y, k, stream); }
+
+// RL per shape: GGML_F44_RL / GGML_MB_RL = "<RL>" or "<rows>x<K>:<RL>,..." (unlisted shapes use 1)
+struct f44_rlmap { std::map<std::pair<int, int>, int> m; int def = 1; };
+static f44_rlmap f44_parse_rl(const char * env) {
+    f44_rlmap r; const char * e = getenv(env); if (!e) return r;
+    std::string s = e;
+    if (s.find(':') == std::string::npos) { r.def = atoi(s.c_str()); return r; }
+    size_t p = 0;
+    while (p < s.size()) {
+        size_t q = s.find(',', p); if (q == std::string::npos) q = s.size();
+        int rr = 0, k = 0, rl = 1; if (sscanf(s.substr(p, q - p).c_str(), "%dx%d:%d", &rr, &k, &rl) == 3) r.m[{rr, k}] = rl;
+        p = q + 1;
+    }
+    return r;
+}
+static int f44_rl_of(const f44_rlmap & r, int rows, int K) {
+    auto it = r.m.find({rows, K}); const int rl = it == r.m.end() ? r.def : it->second;
+    return rl == 2 || rl == 4 ? rl : 1;
+}
+static int f44_rl(int rows, int K) { static const f44_rlmap r = f44_parse_rl("GGML_F44_RL"); return f44_rl_of(r, rows, K); }
+static int mb_rl(int rows, int K)  { static const f44_rlmap r = f44_parse_rl("GGML_MB_RL");  return f44_rl_of(r, rows, K); }
+
+static void mb_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+static void vr_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+void ggml_cuda_f44_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (ggml_cuda_f44_mode() == 2) { mb_mul_mat_vec(ctx, src0, src1, dst); return; }
+    if (ggml_cuda_f44_mode() >= 3) { vr_mul_mat_vec(ctx, src0, src1, dst); return; }   // R49 VR arms
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+    cudaStream_t stream = ctx.stream();
+    const int K = (int)src0->ne[0], rows = (int)src0->ne[1];
+    GGML_ASSERT(src1->ne[0] == K && dst->ne[0] == rows);
+    const int64_t ne10_padded = GGML_PAD(K, MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<char> q8(ctx.pool(), ne10_padded * sizeof(block_q8_1) / QK8_1);
+    const int64_t s11 = src1->nb[1] / sizeof(float), s12 = src1->nb[2] / sizeof(float), s13 = src1->nb[3] / sizeof(float);
+    quantize_row_q8_1_cuda((const float *)src1->data, nullptr, q8.get(), src0->type, K, s11, s12, s13, ne10_padded, 1, 1, 1, stream);
+    float * y = (float *)dst->data;
+    CUDA_CHECK(cudaMemsetAsync(y, 0, (size_t)rows * sizeof(float), stream));
+    f44_args a{(const uint4 *)src0->data, (const half *)((const char *)src0->data + (size_t)rows * K / 4), (const block_q8_1 *)q8.get(), y,
+               rows, K / 128, rows / 32, F44_LEV4};
+    const int RL = f44_rl(rows, K), nrb = (a.nb32 + 8 * RL - 1) / (8 * RL);
+    static std::once_flag hello; std::call_once(hello, [] { fprintf(stderr, "F44: lut36 GEMV hook active (IQ2_XXS bytes reinterpreted as F44)\n"); });
+    if (RL == 1) k_f44_lut<1><<<nrb * a.nsl, 256, 0, stream>>>(a);
+    else if (RL == 2) k_f44_lut<2><<<nrb * a.nsl, 256, 0, stream>>>(a);
+    else k_f44_lut<4><<<nrb * a.nsl, 256, 0, stream>>>(a);
+    CUDA_CHECK(cudaGetLastError());
+
+    static const bool check = [] { const char * e = getenv("GGML_F44_CHECK"); return e && atoi(e) == 1; }();
+    if (check) {   // device check vs an fp32 reference on the same activations, once per shape, outside graph capture
+        static std::map<std::pair<int, int>, int> done; static std::mutex mu;
+        cudaStreamCaptureStatus cs; CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+        std::lock_guard<std::mutex> lk(mu);
+        if (cs == cudaStreamCaptureStatusNone && !done[{rows, K}]) {
+            done[{rows, K}] = 1;
+            float * yr; CUDA_CHECK(cudaMallocAsync(&yr, rows * sizeof(float), stream));
+            k_f44_ref<<<rows, 32, 0, stream>>>(a.W, a.S, a.X, yr, rows, K, F44_LEV4);
+            std::vector<float> h0(rows), h1(rows);
+            CUDA_CHECK(cudaMemcpyAsync(h0.data(), y, rows * sizeof(float), cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaMemcpyAsync(h1.data(), yr, rows * sizeof(float), cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream)); CUDA_CHECK(cudaFreeAsync(yr, stream));
+            double md = 0, mr = 0, mr0 = 0; int bad = 0;
+            for (int r = 0; r < rows; ++r) mr0 = fmax(mr0, fabs((double)h1[r]));
+            for (int r = 0; r < rows; ++r) { const double d = fabs((double)h0[r] - h1[r]); md = fmax(md, d); mr = fmax(mr, fabs((double)h1[r])); bad += d > 1e-5 * mr0; }
+            fprintf(stderr, "F44CHECK rows %d K %d RL %d maxabsdiff %.3e maxabsref %.3e rel %.3e rows_over_1e-5_of_max %d\n", rows, K, RL, md, mr, mr > 0 ? md / mr : 0.0, bad);
+        }
+    }
+}
+
+// ================================================================================================ Model B (A1) arm, GGML_F44=2
+// k_mb = k_b2 of research/kernels/r47_vr.cu (lut36-B2: bitshift trellis L=8, d=2, tail-biting per 64-col slice; tile classes
+// 0..7 per 32 rows x 256 cols at 0/1/1.5/2/2.5/3/4/6 b/w; c7 = k 8 + a 4-bit second lookup; fp16 tile scale x 2^(-d/8) with a
+// 5-bit d per row-block; u16 row perm). Activations: int8 + one float scale per 128 (q8_128). Changes vs k_b2: no next-buffer
+// zeroing (memset node), 2^(-d/8) table read from a __device__ array, codebook in c_mb_cw.
+// In-tensor layout (bytes, all inside ggml_nbytes of the IQ2_XXS tensor = rows*K*66/256; fixed offsets first so the native MMQ
+// loader in mmq-load-tiles.cuh can find everything from rows and K):
+//   CW   256 u32 codebook (int8 x2 in the low bytes; copy of c_mb_cw)      at 0
+//   DEXP 32 f32, 2^(-d/8)                                                  at 1024
+//   M    u32 per tile: word offset | class << 29                           at 1152
+//   DL   5 u32 per tile (5-bit d per row, 32 rows)                         at offDL = 1152 + 4 nt
+//   TS   fp16 per tile                                                     at offTS = offDL + 20 nt
+//   P    u16 per stored row: output row                                    at offP  = offTS + 2 nt
+//   PINV u16 per output row: stored row (batch path only; +16/K bpw)       at offPI = offP + 2 rows
+//   D    payload u32 words, per tile 4 slices x NW(c) words x 32 lanes     at offD  = align16(offPI + 2 rows)
+typedef uint32_t u32;
+__constant__ u32 c_mb_cw[256];
+__device__ float g_mb_dexp[32];
+__host__ __device__ constexpr int mbK(int c) { return c == 0 ? 0 : c <= 5 ? c + 1 : 8; }
+__host__ __device__ constexpr int mbNW(int c) { return mbK(c) + (c == 7 ? 4 : 0); }
+static const double MB_RATE[8] = {0, 1, 1.5, 2, 2.5, 3, 4, 6};
+// class histograms (blk.16 VRten cls_hist, logs/r41s_proxy_full.log; same as r47_vr.cu H_ATTN / H_GATE / H_DOWN)
+static const double MB_H_ATTN[8] = {244, 3432, 9602, 19353, 4450, 2632, 1058, 189};
+static const double MB_H_GATE[8] = {57, 1691, 10327, 21950, 4243, 1595, 1064, 33};
+static const double MB_H_DOWN[8] = {222, 2717, 7828, 80376, 3932, 1087, 955, 163};
+
+struct mb_meta { size_t offM, offDL, offTS, offP, offPI, offD; int rows, K, nb, ng; double bpw; size_t hist[8]; };
+static std::map<const void *, mb_meta> g_mb;      // by tensor data pointer
+static std::map<const void *, int> g_f44_prepped;
+static std::mutex g_mb_mu;
+
+struct mb_args { const u32 * D; const u32 * M; const half * TS; const u32 * DL; const uint16_t * P; const int8_t * X; const float * XS; float * y; int nsl, nb, ng; };
+
+static __device__ __forceinline__ u32 mb_shv(u32 x, int d) { return d >= 0 ? (x << d) : (x >> -d); }
+static __device__ __forceinline__ u32 mb_win8(const u32 * e, int p) {
+    const int wi = p >> 5, bb = p & 31;
+    const u32 v = bb + 8 <= 32 ? mb_shv(e[wi], 7 - bb) : __funnelshift_r(e[wi], e[wi + 1], bb - 7);
+    return v & 0x7F80u;
+}
+template <int C>
+static __device__ __forceinline__ int mb_run(const u32 (&wd)[12], int lane, const int * T) {
+    constexpr int K = mbK(C);
+    u32 e[K + 1]; e[0] = wd[K - 1];
+#pragma unroll
+    for (int i = 0; i < K; ++i) e[i + 1] = wd[i];
+    const u32 lane4 = (u32)lane << 2; int acc = 0;
+#pragma unroll
+    for (int s = 0; s < 32; ++s) {
+        const u32 off = (lane4 + 4u * s) & 124u;
+        int v = *(const int *)((const char *)T + (mb_win8(e, 24 + (s + 1) * K) | off));
+        if (C == 7) { const u32 x4 = mb_shv(wd[8 + (s >> 3)], 7 - 4 * (s & 7)) & 0x780u; v = v * 16 + *(const int *)((const char *)T + (x4 | off)); }
+        acc += v;
+    }
+    return acc;
+}
+template <int NW> static __device__ __forceinline__ void mb_load(u32 (&wd)[12], const u32 * p, int lane) {
+#pragma unroll
+    for (int i = 0; i < NW; ++i) wd[i] = __ldcs(p + i * 32 + lane);
+}
+template <int RL>
+static __global__ void __launch_bounds__(256, 2) k_mb(const mb_args a) {
+    __shared__ __align__(16) int T[8192];
+    __shared__ float sDX[32];
+    const int tid = threadIdx.x, lane = tid & 31, w = tid >> 5;
+    const int s = blockIdx.x % a.nsl, rb = blockIdx.x / a.nsl, b = s >> 2, q = s & 3;
+    if (tid < 32) sDX[tid] = g_mb_dexp[tid];
+    const int g0 = (rb * 8 + w) * RL;
+    u32 wd[RL][12]; int cl[RL]; float sc[RL]; int pr[RL];
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int g = g0 + m; cl[m] = 0; sc[m] = 0.f; pr[m] = 0;
+        if (g < a.ng) {
+            const size_t ti = (size_t)g * a.nb + b; const u32 mt = __ldg(a.M + ti); cl[m] = mt >> 29;
+            const u32 * p = a.D + (mt & 0x1FFFFFFFu) + (size_t)q * mbNW(cl[m]) * 32;
+            switch (cl[m]) {
+                case 1: mb_load<mbNW(1)>(wd[m], p, lane); break; case 2: mb_load<mbNW(2)>(wd[m], p, lane); break;
+                case 3: mb_load<mbNW(3)>(wd[m], p, lane); break; case 4: mb_load<mbNW(4)>(wd[m], p, lane); break;
+                case 5: mb_load<mbNW(5)>(wd[m], p, lane); break; case 6: mb_load<mbNW(6)>(wd[m], p, lane); break;
+                case 7: mb_load<mbNW(7)>(wd[m], p, lane); break; default: break;
+            }
+            const u32 * dl = a.DL + ti * 5; const int bp = 5 * lane;
+            const u32 d = __funnelshift_r(__ldg(dl + (bp >> 5)), __ldg(dl + min((bp >> 5) + 1, 4)), bp & 31) & 31u;
+            sc[m] = __half2float(a.TS[ti]); pr[m] = (int)d | (int)__ldg(a.P + g * 32 + lane) << 5;
+        }
+    }
+    {   // build: entry e of chunk t (2 activations) = dot(cw[e] (int8 x2), x) via dp4a with the upper bytes zero
+        const int x2 = (int)(*(const unsigned short *)(a.X + (size_t)s * 64 + 2 * lane));
+#pragma unroll
+        for (int k = 0; k < 32; ++k) { const int e = w * 32 + k; T[e * 32 + lane] = __dp4a((int)(c_mb_cw[e] & 0xFFFFu), x2, 0); }
+    }
+    __syncthreads();
+    const float xs = a.XS[s >> 1];
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int g = g0 + m;
+        if (g >= a.ng || cl[m] == 0) continue;
+        int acc = 0;
+        switch (cl[m]) {
+            case 1: acc = mb_run<1>(wd[m], lane, T); break; case 2: acc = mb_run<2>(wd[m], lane, T); break;
+            case 3: acc = mb_run<3>(wd[m], lane, T); break; case 4: acc = mb_run<4>(wd[m], lane, T); break;
+            case 5: acc = mb_run<5>(wd[m], lane, T); break; case 6: acc = mb_run<6>(wd[m], lane, T); break;
+            default: acc = mb_run<7>(wd[m], lane, T); break;
+        }
+        atomicAdd(a.y + (pr[m] >> 5), (float)acc * xs * (sc[m] * sDX[pr[m] & 31]));
+    }
+}
+
+// activations -> int8 + one float scale per 128 (one warp per 128 block)
+static __global__ void k_mb_qx(const float * x, int8_t * X, float * XS, int K) {
+    const int blk = blockIdx.x * 8 + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (blk * 128 >= K) return;
+    const float4 v = *(const float4 *)(x + (size_t)blk * 128 + 4 * lane);
+    float am = fmaxf(fmaxf(fabsf(v.x), fabsf(v.y)), fmaxf(fabsf(v.z), fabsf(v.w)));
+    for (int o = 16; o > 0; o >>= 1) am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, o));
+    const float d = am / 127.f, id = d > 0.f ? 1.f / d : 0.f;
+    char4 q; q.x = (int8_t)__float2int_rn(v.x * id); q.y = (int8_t)__float2int_rn(v.y * id); q.z = (int8_t)__float2int_rn(v.z * id); q.w = (int8_t)__float2int_rn(v.w * id);
+    *(char4 *)(X + (size_t)blk * 128 + 4 * lane) = q;
+    if (lane == 0) XS[blk] = d;
+}
+
+// independent per-weight decoder (bit by bit, as cpu_b2): integer weight value of stored row (g, j) at column col, and its float scale
+static __device__ int mb_wint(const u32 * D, const u32 * M, int nb, int g, int j, int col, int * cls) {
+    const int b = col >> 8, q = (col >> 6) & 3, t = (col & 63) >> 1, i = col & 1;
+    const u32 mt = M[(size_t)g * nb + b]; const int c = mt >> 29; *cls = c;
+    if (!c) return 0;
+    const int K = mbK(c), NW = mbNW(c);
+    const u32 * p = D + (mt & 0x1FFFFFFFu) + (size_t)q * NW * 32 + j;          // word i of this lane-slice = p[32 * i]
+    const int st = (t - j) & 31;                                                // step at which lane j reads chunk t
+    u32 wv = 0;
+    for (int k = 0; k < 8; ++k) {
+        const int pos = (((st + 1) * K - 8 + k) % (32 * K) + 32 * K) % (32 * K);
+        wv |= ((p[32 * (pos >> 5)] >> (pos & 31)) & 1u) << k;
+    }
+    int v = (int)(int8_t)(c_mb_cw[wv] >> (8 * i));
+    if (c == 7) { const int sx = (p[32 * (8 + (st >> 3))] >> (4 * (st & 7))) & 15; v = v * 16 + (int)(int8_t)(c_mb_cw[sx] >> (8 * i)); }
+    return v;
+}
+static __device__ float mb_scale(const half * TS, const u32 * DL, int nb, int g, int j, int col) {
+    const size_t ti = (size_t)g * nb + (col >> 8); const int bp = 5 * j;
+    const u32 lo = DL[ti * 5 + (bp >> 5)], hi = DL[ti * 5 + min((bp >> 5) + 1, 4)];
+    const u32 d = __funnelshift_r(lo, hi, bp & 31) & 31u;
+    return __half2float(TS[ti]) * g_mb_dexp[d];
+}
+// fp32 reference GEMV on the same q8_128 activations (GGML_F44_CHECK)
+static __global__ void k_mb_ref(mb_args a, int K, float * y) {
+    const int sr = blockIdx.x, lane = threadIdx.x, g = sr >> 5, j = sr & 31; float acc = 0.f; int cls;
+    for (int col = lane; col < K; col += 32) acc += (float)mb_wint(a.D, a.M, a.nb, g, j, col, &cls) * mb_scale(a.TS, a.DL, a.nb, g, j, col) * (a.XS[col >> 7] * (float)a.X[col]);
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+    if (lane == 0) y[a.P[sr]] = acc;
+}
+
+// ------------------------------------------------------------------------------------------------ batch path: decode to Q8_0
+struct f44_q8 { half d; int8_t qs[32]; };
+static_assert(sizeof(f44_q8) == 34, "q8_0 block");
+static __device__ __forceinline__ void f44_put_q8(char * dst, float d, const int * v) {
+    unsigned short * o = (unsigned short *)dst;
+    o[0] = __half_as_ushort(__float2half(d));
+#pragma unroll
+    for (int i = 0; i < 16; ++i) o[1 + i] = (unsigned short)((uint8_t)(int8_t)v[2 * i] | (unsigned)(uint8_t)(int8_t)v[2 * i + 1] << 8);
+}
+// F44 -> Q8_0, exact (d = d_w fp16, qs = level). Thread = (row, 32-col block), consecutive threads along the row.
+static __global__ void k_f44_to_q8(const uint4 * W, const half * S, char * y, int rows, int K, int lev4) {
+    const size_t idx = (size_t)blockIdx.x * blockDim.x + threadIdx.x; const int nbk = K >> 5;
+    if (idx >= (size_t)rows * nbk) return;
+    const int r = idx / nbk, cb = idx % nbk, s = cb >> 2, nb32 = rows >> 5, lane = r & 31;
+    const uint4 * base = W + ((size_t)s * nb32 + (r >> 5)) * 64 + lane;
+    int v[32];
+#pragma unroll
+    for (int u = 0; u < 8; ++u) {
+        const int t = (cb & 3) * 8 + u, k = lane ^ t;
+        const uint8_t byte = ((const uint8_t *)(base + (k >> 4) * 32))[k & 15];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) v[4 * u + i] = f44_sx8(lev4, (byte >> (2 * i)) & 3);
+    }
+    f44_put_q8(y + ((size_t)r * nbk + cb) * 34, __half2float(S[(size_t)(cb >> 3) * rows + r]), v);
+}
+// Model B -> Q8_0. Thread = (stored row, 64-col slice) -> 2 blocks of output row P[row]. Classes 1-6: qs = codeword bytes
+// (exact ints), d = fp16(ts * 2^(-d/8)) (rel. error <= 2^-11 from the fp16 rounding of the product). Class 7 (16a+b, up to
+// +-1088): rounded to int8 with a per-32 scale (NOT exact; only the batch path; share of tiles reported at prepare).
+template <int C>
+static __device__ __forceinline__ void mb_dec_slice(const u32 * p, int j, const u32 * cw, int * v) {
+    constexpr int K = mbK(C), NW = mbNW(C);
+    u32 wd[12];
+#pragma unroll
+    for (int i = 0; i < NW; ++i) wd[i] = p[32 * i];
+    u32 e[K + 1]; e[0] = wd[K - 1];
+#pragma unroll
+    for (int i = 0; i < K; ++i) e[i + 1] = wd[i];
+#pragma unroll
+    for (int st = 0; st < 32; ++st) {
+        const int t = (j + st) & 31; const u32 cwv = cw[mb_win8(e, 24 + (st + 1) * K) >> 7];
+        int v0 = (int)(int8_t)cwv, v1 = (int)(int8_t)(cwv >> 8);
+        if (C == 7) { const u32 sx = cw[(mb_shv(wd[8 + (st >> 3)], 7 - 4 * (st & 7)) & 0x780u) >> 7]; v0 = v0 * 16 + (int)(int8_t)sx; v1 = v1 * 16 + (int)(int8_t)(sx >> 8); }
+        v[2 * t] = v0; v[2 * t + 1] = v1;
+    }
+}
+static __global__ void __launch_bounds__(256) k_mb_to_q8(const mb_args a, char * y, int rows, int K) {
+    __shared__ u32 cw[256];
+    cw[threadIdx.x] = c_mb_cw[threadIdx.x];
+    __syncthreads();
+    const int nsl = K >> 6; const size_t idx = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= (size_t)rows * nsl) return;
+    const int sr = idx / nsl, sl = idx % nsl, g = sr >> 5, j = sr & 31, b = sl >> 2, q = sl & 3;
+    const size_t ti = (size_t)g * a.nb + b; const u32 mt = a.M[ti]; const int c = mt >> 29;
+    int v[64];
+    const u32 * p = a.D + (mt & 0x1FFFFFFFu) + (size_t)q * mbNW(c) * 32 + j;
+    switch (c) {
+        case 1: mb_dec_slice<1>(p, j, cw, v); break; case 2: mb_dec_slice<2>(p, j, cw, v); break;
+        case 3: mb_dec_slice<3>(p, j, cw, v); break; case 4: mb_dec_slice<4>(p, j, cw, v); break;
+        case 5: mb_dec_slice<5>(p, j, cw, v); break; case 6: mb_dec_slice<6>(p, j, cw, v); break;
+        case 7: mb_dec_slice<7>(p, j, cw, v); break;
+        default:
+#pragma unroll
+            for (int i = 0; i < 64; ++i) v[i] = 0;
+    }
+    const int bp = 5 * j; const u32 dd = __funnelshift_r(a.DL[ti * 5 + (bp >> 5)], a.DL[ti * 5 + min((bp >> 5) + 1, 4)], bp & 31) & 31u;
+    const float d = __half2float(a.TS[ti]) * g_mb_dexp[dd];
+    const int nbk = K >> 5; char * o = y + ((size_t)a.P[sr] * nbk + 2 * sl) * 34;
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        int * vh = v + 32 * h; float dh = d;
+        if (c == 7) {
+            int am = 0;
+#pragma unroll
+            for (int i = 0; i < 32; ++i) am = max(am, abs(vh[i]));
+            const float s = am > 127 ? am / 127.f : 1.f; dh = d * s;
+#pragma unroll
+            for (int i = 0; i < 32; ++i) vh[i] = __float2int_rn(vh[i] / s);
+        }
+        f44_put_q8(o + 34 * h, dh, vh);
+    }
+}
+// GGML_F44_CHECK: Q8_0 buffer vs the per-weight reference decoders (Model B: per class; F44: all)
+static __global__ void k_q8_check(const char * y, int rows, int K, int mode, mb_args a, const uint4 * W, const half * S, int lev4,
+                                  unsigned long long * cnt, float * mx) {
+    const size_t idx = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= (size_t)rows * K) return;
+    const int sr = idx / K, col = idx % K;
+    float ref; int cls = 0, orow = sr;
+    if (mode == 1) ref = f44_weight(W, S, rows, K >> 7, lev4, sr, col);
+    else { const int g = sr >> 5, j = sr & 31; ref = (float)mb_wint(a.D, a.M, a.nb, g, j, col, &cls) * mb_scale(a.TS, a.DL, a.nb, g, j, col); orow = a.P[sr]; }
+    const f44_q8 * blk = (const f44_q8 *)(y + ((size_t)orow * (K >> 5) + (col >> 5)) * 34);
+    const float got = __half2float(blk->d) * (float)blk->qs[col & 31];
+    const float err = fabsf(got - ref), rel = err / fmaxf(fabsf(ref), 1e-30f);
+    const int bucket = cls == 7 ? 1 : 0;
+    if (err > 0.f) atomicAdd(cnt + bucket, 1ull);
+    if (ref != 0.f) atomicMax((int *)(mx + bucket), __float_as_int(rel));   // rel >= 0: int order = float order
+    if (ref == 0.f && got != 0.f) atomicAdd(cnt + 2, 1ull);
+}
+
+static mb_args mb_args_of(const ggml_tensor * src0, const mb_meta & mm) {
+    const char * base = (const char *)src0->data;
+    return mb_args{(const u32 *)(base + mm.offD), (const u32 *)(base + mm.offM), (const half *)(base + mm.offTS), (const u32 *)(base + mm.offDL),
+                   (const uint16_t *)(base + mm.offP), nullptr, nullptr, nullptr, mm.K / 64, mm.nb, mm.ng};
+}
+static const mb_meta & mb_get(const ggml_tensor * src0) {
+    std::lock_guard<std::mutex> lk(g_mb_mu);
+    auto it = g_mb.find(src0->data); GGML_ASSERT(it != g_mb.end() && "Model B tensor not prepared");
+    return it->second;
+}
+
+static uint64_t f44_sm64(uint64_t & s) { uint64_t z = (s += 0x9E3779B97F4A7C15ull); z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull; z = (z ^ (z >> 27)) * 0x94D049BB133111EBull; return z ^ (z >> 31); }
+static __global__ void k_fill_rand(u32 * p, size_t n, uint64_t seed) {
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (size_t)gridDim.x * blockDim.x) {
+        uint64_t z = seed + 0x9E3779B97F4A7C15ull * (i + 1); z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull; z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+        p[i] = (u32)(z ^ (z >> 31));
+    }
+}
+static __global__ void k_fill_scale(half * p, size_t n, uint64_t seed, float lo, float span) {
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (size_t)gridDim.x * blockDim.x) {
+        uint64_t z = seed + 0x9E3779B97F4A7C15ull * (i + 1); z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull; z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+        p[i] = __float2half(lo + span * (float)((z >> 40) & 0xFFFF) / 65535.f);
+    }
+}
+
+static u32 g_mb_cw_h[256]; static float g_mb_dx_h[32];
+static void mb_init_tables() {
+    static std::once_flag once;
+    std::call_once(once, [] {
+        // codebook: the solver's joint single B2 table (research/work/r48p/joint_table.pt), int8 file from GGML_MB_CW or the default path;
+        // random int8 x2 in [-64, 64] only if the file is missing (timing does not depend on the values)
+        std::string fn = getenv("GGML_MB_CW") ? getenv("GGML_MB_CW") : std::string(getenv("HOME") ? getenv("HOME") : "") + "/repo/research/kernels/joint_table_i8.bin";
+        FILE * f = fopen(fn.c_str(), "rb"); int8_t q[512]; float step = 0.f;
+        const bool joint = f && fread(&step, 4, 1, f) == 1 && fread(q, 1, 512, f) == 512;
+        if (f) fclose(f);
+        uint64_t s = 4747;
+        for (int e = 0; e < 256; ++e) {
+            if (joint) { g_mb_cw_h[e] = (u32)(uint8_t)q[2 * e] | (u32)(uint8_t)q[2 * e + 1] << 8; continue; }
+            g_mb_cw_h[e] = 0; for (int i = 0; i < 2; ++i) g_mb_cw_h[e] |= (u32)(uint8_t)(int8_t)((int)(f44_sm64(s) % 129) - 64) << (8 * i);
+        }
+        fprintf(stderr, "MB codebook: %s\n", joint ? "joint single table (int8, solver r48p)" : "random int8 (joint table file missing)");
+        for (int d = 0; d < 32; ++d) g_mb_dx_h[d] = (float)std::exp2(-d / 8.0);
+        CUDA_CHECK(cudaMemcpyToSymbol(c_mb_cw, g_mb_cw_h, sizeof(g_mb_cw_h)));
+        CUDA_CHECK(cudaMemcpyToSymbol(g_mb_dexp, g_mb_dx_h, sizeof(g_mb_dx_h)));
+    });
+}
+
+// overwrite one IQ2_XXS tensor with a random valid Model B tensor (classes per make_b2 of r47_vr.cu: tensor histogram, then
+// trimmed / filled to the byte budget of the IQ2_XXS tensor)
+static void mb_prepare(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    const int K = (int)t->ne[0], rows = (int)t->ne[1], nb = K / 256, ng = rows / 32; const size_t nt = (size_t)ng * nb;
+    const char * nm = ggml_get_name(t);
+    const double * hist = strstr(nm, "ffn_down") ? MB_H_DOWN : (strstr(nm, "ffn_gate") || strstr(nm, "ffn_up")) ? MB_H_GATE : MB_H_ATTN;
+    uint64_t s = 1469598103934665603ull; for (const char * c = nm; *c; ++c) s = (s ^ (uint8_t)*c) * 1099511628211ull;
+    const double nbytes = (double)ggml_nbytes(t);
+    const double side = 1152.0 + nt * (4.0 + 20.0 + 2.0) + rows * 4.0 + 16.0;  // CW + DEXP; M, DL, TS per tile; P + PINV per row; pad
+    const double target = (nbytes - side - 64.0) * 8.0;                         // payload bits available
+    std::vector<uint8_t> cls(nt);
+    double cum[8], tot = 0; for (int c = 0; c < 8; ++c) { tot += hist[c]; cum[c] = tot; }
+    for (auto & c : cls) { const double u = (f44_sm64(s) >> 11) * (1.0 / 9007199254740992.0) * tot; int k = 0; while (k < 7 && u >= cum[k]) ++k; c = (uint8_t)k; }
+    double bits = 0; for (auto c : cls) bits += MB_RATE[c] * 8192;
+    while (bits > target) { const size_t i = f44_sm64(s) % nt; if (cls[i] > 0) { bits -= (MB_RATE[cls[i]] - MB_RATE[cls[i] - 1]) * 8192; --cls[i]; } }
+    for (int fails = 0; fails < 2000;) { const size_t i = f44_sm64(s) % nt; if (cls[i] == 7) { ++fails; continue; } const double d = (MB_RATE[cls[i] + 1] - MB_RATE[cls[i]]) * 8192;
+        if (bits + d <= target) { bits += d; ++cls[i]; fails = 0; } else ++fails; }
+    std::vector<u32> M(nt), DL(nt * 5); std::vector<half> TS(nt); std::vector<uint16_t> P(rows), PI(rows);
+    size_t off = 0; mb_meta mm{}; mm.rows = rows; mm.K = K; mm.nb = nb; mm.ng = ng;
+    for (size_t i = 0; i < nt; ++i) { M[i] = (u32)off | (u32)cls[i] << 29; off += (size_t)4 * mbNW(cls[i]) * 32; ++mm.hist[cls[i]]; }
+    GGML_ASSERT(off < (1u << 29));
+    for (auto & v : DL) v = (u32)f44_sm64(s);
+    for (auto & v : TS) v = __float2half(4e-4f + (f44_sm64(s) % 1000) * 2e-7f);  // weight std ~ 0.02 with |cw| <= 64
+    for (int r = 0; r < rows; ++r) P[r] = (uint16_t)r;
+    for (int r = rows - 1; r > 0; --r) std::swap(P[r], P[f44_sm64(s) % (r + 1)]);
+    for (int r = 0; r < rows; ++r) PI[P[r]] = (uint16_t)r;
+    mm.offM = 1152; mm.offDL = mm.offM + nt * 4; mm.offTS = mm.offDL + nt * 20; mm.offP = mm.offTS + nt * 2; mm.offPI = mm.offP + (size_t)rows * 2;
+    mm.offD = (mm.offPI + (size_t)rows * 2 + 15) & ~(size_t)15;
+    const size_t end = mm.offD + off * 4;
+    GGML_ASSERT(end <= ggml_nbytes(t));
+    mm.bpw = 8.0 * end / ((double)rows * K);
+    cudaStream_t st = ctx.stream(); char * base = (char *)t->data;
+    k_fill_rand<<<1024, 256, 0, st>>>((u32 *)(base + mm.offD), off, s ^ 0xABCDEFull);
+    CUDA_CHECK(cudaMemcpyAsync(base, g_mb_cw_h, 1024, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + 1024, g_mb_dx_h, 128, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + mm.offPI, PI.data(), (size_t)rows * 2, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + mm.offM, M.data(), nt * 4, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + mm.offDL, DL.data(), nt * 20, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + mm.offTS, TS.data(), nt * 2, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaMemcpyAsync(base + mm.offP, P.data(), (size_t)rows * 2, cudaMemcpyHostToDevice, st));
+    CUDA_CHECK(cudaStreamSynchronize(st));
+    std::lock_guard<std::mutex> lk(g_mb_mu); g_mb[t->data] = mm;
+}
