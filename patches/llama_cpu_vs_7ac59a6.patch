diff --git a/ggml/src/ggml-cpu/vr-native-cpu-core.h b/ggml/src/ggml-cpu/vr-native-cpu-core.h
new file mode 100644
index 0000000..43baca3
--- /dev/null
+++ b/ggml/src/ggml-cpu/vr-native-cpu-core.h
@@ -0,0 +1,878 @@
+#pragma once
+// R52 (cpu_r52_phone): CPU decode + GEMV/GEMM for the native Pingala-8 Model B tensor (contract ggml/include/ggml-vr-native.h,
+// reference semantics = CUDA vr49.cuh vr_wint / f44.cu k_r51_k1 / k_vr + k_vr_qx_real). Header-only, no ggml dependency, so the
+// standalone checker (research/kernels/llama_cpu52/vrcheck.c) and the ggml-cpu glue (vr-native-cpu.c) compile the same code.
+//
+// Format recap (per 32-row x 256-col tile, sorted rows):
+//   class c = M >> 29 (0..7), payload = 2 half-slices x NW(c) words x 32 lanes, lane j = row j of the tile, step k = chunk (j+k)&31.
+//   stage 1: W1 = 4/6/8 bits (c 1/2/>=3); W1 < 8 uses an MSB word (word 0, bit k) + (W1-1)-bit fields from word 1.
+//   stages 2/3 (c 4-7): W2 = 2/4/8/8 bits, W3 = 8 bits (c 7). All stages index the same 256-entry int8x4 table A.
+//   Pingala-8 trellis (Chandahsutra 1.1-1.8, 8 gana states, Ungerboeck labels): z_t = stage-1 MSB of chunk t,
+//   u_t = z_t ^ u_{t-1} ^ u_{t-3}, coset bit h_t = u_{t-2}, reset per 128-col half-slice; h_t adds c to every stage of chunk t.
+//   weight int = sum_s (A[f_s] + h c) << SH_s;  W_sorted_rot = int * S[b][r] (fp16).
+//   y[prm[r]] = sum_k W_sorted_rot[r,k] x'[k] + (Delta x)[prm[r]],  x' = FWHT256(x * sgn / c) / 16 per 256 block.
+// CPU dataflow: x' quantized to int8 per 128-col half-slice (as the CUDA GEMV k_vr_qx_real), stored twice in a row (256 B) so lane j
+// reads its rotated chunk order as a plain unaligned load at +4j. Decoded weights (coset folded in) are int8 per stage; integer dot
+// per stage, << SH_s, one float multiply per half-slice. Exact integer weights; only the activation is quantized.
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <math.h>
+#include <stdlib.h>
+#if defined(__AVX2__)
+#include <immintrin.h>
+#endif
+#if defined(VRC_SIMDE_NEON)   // research only: x86 functional test of the NEON path through SIMDe's NEON emulation
+#define SIMDE_ENABLE_NATIVE_ALIASES
+#include <simde/arm/neon.h>
+#ifndef __ARM_NEON
+#define __ARM_NEON 1
+#endif
+#elif defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+
+#define VRC_MAGIC0 0x4E525656u
+#define VRC_MAGIC1 0x31354952u
+#define VRC_NS     108u
+
+static inline int vrc_W1(int c) { return c == 0 ? 0 : c == 1 ? 4 : c == 2 ? 6 : 8; }
+static inline int vrc_W2(int c) { return c == 4 ? 2 : c == 5 ? 4 : c >= 6 ? 8 : 0; }
+static inline int vrc_W3(int c) { return c == 7 ? 8 : 0; }
+static inline int vrc_S1(int c) { return c == 4 ? 2 : c == 5 ? 3 : c == 6 ? 2 : c == 7 ? 4 : 0; }   // R51 builder shift fix
+static inline int vrc_S2(int c) { return c == 7 ? 2 : 0; }
+static inline int vrc_NW(int c) { return vrc_W1(c) + vrc_W2(c) + vrc_W3(c); }
+static inline int vrc_nst(int c) { return c == 0 ? 0 : c <= 3 ? 1 : c <= 6 ? 2 : 3; }
+static inline int vrc_MC(int c) { return (1 << vrc_S1(c)) + (vrc_W2(c) ? (1 << vrc_S2(c)) : 0) + (vrc_W3(c) ? 1 : 0); }
+
+static inline float vrc_h2f(uint16_t h) {
+    const uint32_t s = (uint32_t)(h & 0x8000u) << 16, e = (h >> 10) & 0x1fu, mm = h & 0x3ffu;
+    uint32_t f;
+    if (e == 0) { float v = (float)mm * (1.0f / 16777216.0f); memcpy(&f, &v, 4); f |= s; }
+    else if (e == 31) f = s | 0x7f800000u | (mm << 13);
+    else f = s | ((e + 112u) << 23) | (mm << 13);
+    float r; memcpy(&r, &f, 4); return r;
+}
+static inline uint16_t vrc_f2h(float x) {   // round to nearest even (as __float2half)
+    uint32_t f; memcpy(&f, &x, 4);
+    const uint32_t s = (f >> 16) & 0x8000u; int e = (int)((f >> 23) & 0xff) - 127 + 15; uint32_t m = f & 0x7fffffu;
+    if (((f >> 23) & 0xff) == 0xff) return (uint16_t)(s | 0x7c00u | (m ? 0x200u : 0));
+    if (e >= 31) return (uint16_t)(s | 0x7c00u);
+    if (e <= 0) {
+        if (e < -10) return (uint16_t)s;
+        m |= 0x800000u; const int sh = 14 - e; uint32_t hm = m >> sh; const uint32_t rem = m & ((1u << sh) - 1u), half = 1u << (sh - 1);
+        if (rem > half || (rem == half && (hm & 1u))) ++hm;
+        return (uint16_t)(s | hm);
+    }
+    uint32_t hm = m >> 13; const uint32_t rem = m & 0x1fffu; uint32_t he = (uint32_t)e;
+    if (rem > 0x1000u || (rem == 0x1000u && (hm & 1u))) { ++hm; if (hm == 0x400u) { hm = 0; ++he; if (he >= 31) return (uint16_t)(s | 0x7c00u); } }
+    return (uint16_t)(s | (he << 10) | hm);
+}
+
+static inline uint32_t vrc_vadd4(uint32_t a, uint32_t b) { return ((a & 0x7f7f7f7fu) + (b & 0x7f7f7f7fu)) ^ ((a ^ b) & 0x80808080u); }
+typedef struct vrc_meta {
+    const uint8_t * base; size_t n; int rows, K, nb, ng, nsl, nd;
+    const uint32_t * A; uint32_t cs; const uint32_t * M; const uint16_t * S; const uint32_t * D;
+    const uint16_t * c16; const int16_t * prm; const int8_t * sg;
+    uint32_t A2[512];                            // R52 v3: coset folded into the table: A2[f + 256 h] = A[f] + h c (bytewise), ^0x80 if VNNI offset
+    float * ic;                                  // sgn / c per column (as k_r51_k1 / vr_load8: v * (sg / c))
+    int * cp; uint16_t * cc; float * cv;         // clamp delta as CSR by ORIGINAL row (as vr_prepare_native)
+    size_t hist[8];
+    uint8_t TP[4][256];                          // R53 NEON v4: byte planes of A (coset-free), for tbl/tbx lookups
+    uint64_t chash;                              // R53: FNV-1a of c16 (tensors sharing the input and c share the prepared activation)
+} vrc_meta;
+
+static inline int vrc_probe(const uint8_t * base, size_t n, int rows, int K) {
+    if (n < 4096) return 0;
+    uint32_t tr[8]; memcpy(tr, base + n - 32, 32);
+    return tr[0] == VRC_MAGIC0 && tr[1] == VRC_MAGIC1 && tr[4] == (uint32_t)rows && tr[5] == (uint32_t)K && tr[6] == VRC_NS;
+}
+// returns 0 on success; allocates ic + CSR (free with vrc_free)
+static int vrc_init(vrc_meta * m, const uint8_t * base, size_t n, int rows, int K) {
+    memset(m, 0, sizeof(*m));
+    if (!vrc_probe(base, n, rows, K) || K % 256 || rows % 32) return 1;
+    uint32_t tr[8]; memcpy(tr, base + n - 32, 32);
+    m->base = base; m->n = n; m->rows = rows; m->K = K; m->nb = K / 256; m->ng = rows / 32; m->nsl = K / 128; m->nd = (int)tr[3];
+    const size_t nt = (size_t)m->ng * m->nb;
+    m->A = (const uint32_t *)base; m->cs = m->A[512];
+    if (m->A[513] != VRC_NS || m->A[514] != 2) return 2;
+    m->M = (const uint32_t *)(base + 2064); m->S = (const uint16_t *)(base + 2064 + 4 * nt);
+    m->D = (const uint32_t *)(base + ((2064 + 68 * nt + 15) & ~(size_t)15));
+    const size_t offT = n - 32, offSG = offT - 256, offQ = (offSG - 2 * (size_t)rows) & ~(size_t)15, offP = (offQ - 2 * (size_t)rows) & ~(size_t)15,
+                 offC = (offP - 2 * (size_t)K) & ~(size_t)15, offE = (offC - 8 * (size_t)m->nd) & ~(size_t)15;
+    if ((size_t)tr[2] > offE) return 3;
+    m->c16 = (const uint16_t *)(base + offC); m->prm = (const int16_t *)(base + offP); m->sg = (const int8_t *)(base + offSG);
+    for (size_t i = 0; i < nt; ++i) m->hist[m->M[i] >> 29]++;
+    for (int f = 0; f < 256; ++f) { m->A2[f] = m->A[f]; m->A2[256 + f] = vrc_vadd4(m->A[f], m->cs); }
+#if defined(__AVXVNNI__)
+    for (int f = 0; f < 512; ++f) m->A2[f] ^= 0x80808080u;
+#endif
+    for (int f = 0; f < 256; ++f) for (int e = 0; e < 4; ++e) m->TP[e][f] = (uint8_t)(m->A[f] >> (8 * e));
+    m->chash = 1469598103934665603ull; for (int i = 0; i < K; ++i) { m->chash ^= m->c16[i]; m->chash *= 1099511628211ull; }
+    m->ic = (float *)malloc(sizeof(float) * K);
+    for (int i = 0; i < K; ++i) m->ic[i] = (float)m->sg[i & 255] / vrc_h2f(m->c16[i]);
+    m->cp = (int *)calloc(rows + 1, sizeof(int));
+    if (m->nd) {
+        const uint16_t * dr = (const uint16_t *)(base + offE), * dc = dr + m->nd; const float * dv = (const float *)(base + offE + 4 * (size_t)m->nd);
+        m->cc = (uint16_t *)malloc(2 * (size_t)m->nd); m->cv = (float *)malloc(4 * (size_t)m->nd);
+        for (int e = 0; e < m->nd; ++e) m->cp[dr[e] + 1]++;
+        for (int r = 0; r < rows; ++r) m->cp[r + 1] += m->cp[r];
+        int * fill = (int *)malloc(sizeof(int) * rows); memcpy(fill, m->cp, sizeof(int) * rows);
+        for (int e = 0; e < m->nd; ++e) { const int q = fill[dr[e]]++; m->cc[q] = dc[e]; m->cv[q] = dv[e]; }
+        free(fill);
+    }
+    return 0;
+}
+static void vrc_free(vrc_meta * m) { free(m->ic); free(m->cp); free(m->cc); free(m->cv); m->ic = 0; m->cp = 0; m->cc = 0; m->cv = 0; }
+
+// Pingala-8 / Ungerboeck NS 108: u_t = z_t ^ u_{t-1} ^ u_{t-3} solved by doubling; returns h (bit t = u_{t-2}) in chunk order
+static inline uint32_t vrc_ung108(uint32_t pc) {
+    uint32_t u = pc;
+    u ^= (u << 1) ^ (u << 3); u ^= (u << 2) ^ (u << 6); u ^= (u << 4) ^ (u << 12); u ^= (u << 8) ^ (u << 24); u ^= u << 16;
+    return u << 2;
+}
+static inline uint32_t vrc_rotl(uint32_t x, int r) { r &= 31; return r ? (x << r) | (x >> (32 - r)) : x; }
+static inline uint32_t vrc_rotr(uint32_t x, int r) { r &= 31; return r ? (x >> r) | (x << (32 - r)) : x; }
+static inline uint32_t vrc_fld(const uint32_t * w, int wb, int W, int k) {
+    const int pos = W * k, wi = wb + (pos >> 5), bb = pos & 31;
+    const uint64_t v = (uint64_t)w[wi] | ((uint64_t)w[wi + 1] << 32);
+    return (uint32_t)(v >> bb) & ((1u << W) - 1u);
+}
+
+// lane words of (tile payload p0 = D + off, half hs, lane j); w[] zero padded to 32 words
+static inline void vrc_lane_words(const uint32_t * p0, int c, int hs, int j, uint32_t * w) {
+    const int NW = vrc_NW(c);
+    const uint32_t * p = p0 + (size_t)hs * NW * 32 + 2 * j;
+    for (int q = 0; q < NW / 2; ++q) { w[2 * q] = p[q * 64]; w[2 * q + 1] = p[q * 64 + 1]; }
+    for (int i = NW; i < 32; ++i) w[i] = 0;
+}
+// stage-1 MSB word (bit k = z of step k) and h in STEP order (bit k = h of chunk (j+k)&31)
+static inline uint32_t vrc_hk(const uint32_t * w, int c, int j) {
+    uint32_t pm = 0;
+    if (vrc_W1(c) == 8) { for (int i = 0; i < 8; ++i) pm |= (((w[i] & 0x80808080u) * 0x00204081u) >> 28) << (4 * i); }
+    else pm = w[0];
+    return vrc_rotr(vrc_ung108(vrc_rotl(pm, j)), j);
+}
+// portable scalar lane decode: out[s*128 + 4k + e] = int8 byte e of (A[f_s(k)] + h_k c) (step order), s < nst(c)
+static inline void vrc_dec_lane_scalar(const uint32_t * w, int c, uint32_t hk, const uint32_t * A, uint32_t cs, int8_t * out) {
+    const int W1 = vrc_W1(c), W2 = vrc_W2(c), W3 = vrc_W3(c);
+    for (int k = 0; k < 32; ++k) {
+        const uint32_t cm = ((hk >> k) & 1u) ? cs : 0u;
+        const uint32_t f1 = W1 == 8 ? vrc_fld(w, 0, 8, k) : (vrc_fld(w, 1, W1 - 1, k) | ((w[0] >> k) & 1u) << (W1 - 1));
+        uint32_t v = vrc_vadd4(A[f1], cm); memcpy(out + 4 * k, &v, 4);
+        if (W2) { v = vrc_vadd4(A[vrc_fld(w, W1, W2, k)], cm); memcpy(out + 128 + 4 * k, &v, 4); }
