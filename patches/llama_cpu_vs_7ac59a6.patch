+            }
+        }
+    }
+}
+static inline void vrc_tile_v4(const vrc_meta * m, int g, int b, const int8_t * X2, const float * XS, const int32_t * SX, const uint32_t * LHall, float * accY) {
+    vrc_tile_v4_np(1, m, g, b, X2, 0, XS, SX, 0, LHall, 0, accY);
+}
+static inline void vrc_tile_v4x(const vrc_meta * m, int g, int b, const int8_t * X2, size_t xps, const float * XS, const int32_t * SX, size_t sps, const uint32_t * LHall, size_t lhs, float * accY) {
+    vrc_tile_v4_np(2, m, g, b, X2, xps, XS, SX, sps, LHall, lhs, accY);
+}
+#endif
