index 0000000..e1cac07
--- /dev/null
+++ b/ggml/src/ggml-cuda/f44.cuh
@@ -0,0 +1,25 @@
+#pragma once
+// R47 M6/M7: research arms inside llama.cpp (research copy only; the main tree is untouched).
+// GGML_F44=1 : every 2D IQ2_XXS weight is REINTERPRETED as F44 (byte-equal, 2.0625 bpw; random codes, timing is real).
+//   bytes [0, rows*K/4)            : codes, layout of lut36.cu (per 128-col slice, per 32-row block, 64 x uint4)
+//   bytes [rows*K/4, rows*K*66/256) : fp16 d_w, index (slice/2)*rows + row (overwritten once with valid scales)
+// GGML_F44=2 : every 2D IQ2_XXS weight is OVERWRITTEN once (before the first graph) with a random VALID Model B tensor
+//   (A1 format: tile classes per 32x256 + lut36-B2 bitshift L=8 d=2 trellis, k_b2 of research/kernels/r47_vr.cu), same bytes.
+// GGML_F44=3 / 4 (R49): every 2D IQ2_XXS weight is OVERWRITTEN once with a random VALID VRi / VRii-C tensor (vr49.cuh), same bytes;
+//   batch 1 = k_vr (VRi V1 / VRii-C coset V4|V5), batch > 1 = native MMQ tile loader only (GGML_F44_BATCH=2; IQ3_XXS / IQ3_S slots).
+// ne11 == 1 -> lut kernel (F44: k_f44_lut, MB: k_mb = k_b2); dst zeroed by a memset node.
+// ne11 >  1 -> GGML_F44_BATCH=1 (default): decode to Q8_0 in a pool buffer + llama MMQ (int8 tensor cores);
+//              GGML_F44_BATCH=0: F44 dequant fp16 + cuBLAS (the M6 path; F44 only).
+// gate+up GLU fusion is disabled for these tensors (the lut kernels have no fused path).
+#include "common.cuh"
+
+int  ggml_cuda_f44_mode();          // 0 off, 1 F44, 2 Model B, 3 VRi, 4 VRii-C
+bool ggml_cuda_f44_env();
+bool ggml_cuda_f44_active(const ggml_tensor * src0);
+int  ggml_cuda_f44_batch_mode();    // 1 q8_0 + MMQ, 0 fp16 + cuBLAS
+void ggml_cuda_f44_set_dims(int64_t ne00, int64_t ne01);
+void ggml_cuda_f44_prepare_graph(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph);
+void ggml_cuda_f44_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+void ggml_cuda_f44_mul_mat_q8(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+void ggml_cuda_f44_to_fp16(const void * x, half * y, int64_t k, cudaStream_t stream);
+void ggml_cuda_f44_to_fp32(const void * x, float * y, int64_t k, cudaStream_t stream);
