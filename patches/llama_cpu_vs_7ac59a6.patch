+// ------------------------------------------------------------------------- R49b re-layout pre-pass (batch path, once per matmul)
+// X2 = [A | B | c, NS, TRL, mode=2 (words 0..515) | u64 VR tensor pointer at byte 2064 | I1 at byte 2304: rows x K/4 stage-1 index
+// bytes in natural chunk order | H: rows x K/128 u32 coset words (bit t = h of chunk t)]. Thread = (row r, 128-col half-slice s).
+static __global__ void k_vr_hdr(const u32 * src, u32 * dst, const char * orig, u32 mode, int r_off = 0, int rows_full = 0, u32 hlp = 0, u32 o_off = 0, u32 o_pl = 0) {
+    for (int i = threadIdx.x; i < 516; i += blockDim.x) dst[i] = i == 515 ? mode : src[i];
+    if (threadIdx.x == 0) { dst[518] = (u32)r_off; dst[519] = (u32)rows_full; dst[522] = hlp; dst[523] = o_off; dst[524] = o_pl; }   // R51c: hi/lo plane pre-pass   // R51 slab (words 518/519, after the pointer at byte 2064)
+    if (threadIdx.x == 0) *(unsigned long long *)((char *)dst + 2064) = (unsigned long long)orig;
+}
+template <int C> static __device__ __forceinline__ void vr_rl_slice(const u32 * p, int mw, u32 (&O)[8], u32 & pm) {
+    constexpr int W1 = vrW1(C);
+    u32 w[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) w[i] = i < W1 ? __ldg(p + (i >> 1) * 64 + (i & 1)) : 0u;
+    if (W1 == 8 && !mw) {
+        pm = 0;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) { O[i] = w[i]; pm |= (((w[i] & 0x80808080u) * 0x00204081u) >> 28) << (4 * i); }
+        return;
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) O[i] = 0;
+    pm = mw ? w[0] : 0u;
+#pragma unroll
+    for (int k = 0; k < 32; ++k) {
+        u32 f;
+        if (mw) {
+            constexpr int We = W1 - 1; const int pos = We * k, wi = 1 + pos / 32, bb = pos % 32;
+            f = (bb + We <= 32 ? (w[wi] >> bb) : __funnelshift_r(w[wi], w[wi + 1], bb)) & ((1u << We) - 1u);
+            f |= ((w[0] >> k) & 1u) << We;
+        } else {
+            const int pos = W1 * k, wi = pos / 32, bb = pos % 32;
+            f = (bb + W1 <= 32 ? (w[wi] >> bb) : __funnelshift_r(w[wi], w[wi + 1], bb)) & ((1u << W1) - 1u);
+            if (W1 < 8) pm |= ((f >> (W1 - 1)) & 1u) << k;
+        }
+        O[k >> 2] |= f << (8 * (k & 3));
+    }
+}
+#include "vr49_dec.h"
+static __global__ void __launch_bounds__(256) k_vr_relayout(const char * x, int V, int rows, int K, uint8_t * I1, u32 * H, u32 * Q8, float * SC, int r_off = 0, int rows_full = 0,
