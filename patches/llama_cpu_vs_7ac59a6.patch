+void ggml_cuda_f44_prepare_graph(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph) {
+    const int mode = ggml_cuda_f44_mode(); if (!mode) return;
+    if (vr_native_env() && (mode != 4 || ggml_cuda_f44_batch_mode() != 2)) { fprintf(stderr, "VR native: needs GGML_F44=4 GGML_F44_BATCH=2\n"); GGML_ABORT("VR native mode"); }
+    if (mode == 2) mb_init_tables();
+    if (mode >= 3 && !vr_native_env()) vr_init_tables();   // R51 native: tables come from the tensors (vr_prepare_native), not random
+    int nnew = 0; size_t hist[8] = {0}; double bytes = 0, w = 0;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * n = cgraph->nodes[i];
+        if (n->op != GGML_OP_MUL_MAT || !n->src[0]) continue;
+        if (mode >= 3 && vr_native_env() ? !vr_native_probe(ctx, n->src[0]) : !ggml_cuda_f44_active(n->src[0])) continue;
+        const ggml_tensor * t = n->src[0];
+        if (mode >= 3) {
+            { std::lock_guard<std::mutex> lk(g_mb_mu); if (g_vr.count(t->data)) continue; }
+            vr_prepare(ctx, t); const vr_meta & vm = vr_get(t); ++nnew;
+            for (int c = 0; c < 8; ++c) hist[c] += vm.hist[c];
+            bytes += vm.bpw * t->ne[0] * t->ne[1] / 8.0; w += (double)t->ne[0] * t->ne[1];
+        } else if (mode == 2) {
+            { std::lock_guard<std::mutex> lk(g_mb_mu); if (g_mb.count(t->data)) continue; }
+            mb_prepare(ctx, t); const mb_meta & mm = mb_get(t); ++nnew;
