+// ---------------------------------------------------------------------------------------------- reference dequant (f32), K1 semantics
+// rotated sorted domain: Wrot[r][col] = int * S  (vr_wint * vr_wscale)
+static inline void vrc_decode_tile_int(const vrc_meta * m, int g, int b, int16_t * xi /* [32][256] */) {
+    const uint32_t mt = m->M[(size_t)g * m->nb + b]; const int c = (int)(mt >> 29);
+    if (!c) { memset(xi, 0, 32 * 256 * 2); return; }
+    const int nst = vrc_nst(c), S1 = vrc_S1(c), S2 = vrc_S2(c);
+    const uint32_t * p0 = m->D + (mt & 0x1FFFFFFFu);
+    uint32_t w[32]; int8_t o[384];
+    for (int hs = 0; hs < 2; ++hs) for (int j = 0; j < 32; ++j) {
+        vrc_lane_words(p0, c, hs, j, w);
+        vrc_dec_lane_scalar(w, c, vrc_hk(w, c, j), m->A, m->cs, o);
+        for (int k = 0; k < 32; ++k) { const int t = (j + k) & 31;
+            for (int e = 0; e < 4; ++e) {
+                int x = (int)o[4 * k + e] * (1 << S1);
+                if (nst > 1) x += (int)o[128 + 4 * k + e] * (1 << S2);
+                if (nst > 2) x += (int)o[256 + 4 * k + e];
+                xi[j * 256 + hs * 128 + 4 * t + e] = (int16_t)x;
+            }
+        }
+    }
+}
+// original domain f32 (rows x K, row-major by ORIGINAL row): W = (H256(int*S)/16) * (sgn/c) + Delta  (k_r51_k1 order of float ops)
+static inline void vrc_dequant_f32(const vrc_meta * m, float * W) {
+    int16_t * xi = (int16_t *)malloc(32 * 256 * 2);
+    for (int g = 0; g < m->ng; ++g) for (int b = 0; b < m->nb; ++b) {
+        vrc_decode_tile_int(m, g, b, xi);
+        for (int j = 0; j < 32; ++j) {
+            const int r = g * 32 + j, ro = m->prm[r]; const float sc = vrc_h2f(m->S[(size_t)b * m->rows + r]);
+            float v[256];
+            for (int i = 0; i < 256; ++i) v[i] = (float)xi[j * 256 + i] * sc;
+            vrc_fwht256(v);
+            for (int i = 0; i < 256; ++i) v[i] *= m->ic[b * 256 + i];
+            for (int e = m->cp[ro]; e < m->cp[ro + 1]; ++e) { const int col = (int)m->cc[e] - b * 256; if (col >= 0 && col < 256) v[col] += m->cv[e]; }
+            memcpy(W + (size_t)ro * m->K + b * 256, v, sizeof(v));
+        }
+    }
+    free(xi);
+}
diff --git a/ggml/src/ggml-cpu/vr-native-cpu.c b/ggml/src/ggml-cpu/vr-native-cpu.c
new file mode 100644
index 0000000..e32b6d5
--- /dev/null
+++ b/ggml/src/ggml-cpu/vr-native-cpu.c
@@ -0,0 +1,279 @@
+// R52 (research/agents/cpu_r52_phone.md): ggml-cpu glue for the native Pingala-8 Model B tensors. The math is in vr-native-cpu-core.h.
+// Phase 1 (all threads): x' = FWHT256(x * sgn / c) / 16, q8 per 128-col half-slice, stored twice (rotation-free lane loads).
+// Phase 2 (dynamic chunks over 32-row groups x column blocks): decode each tile once, int8 dot per stage, << shift, row un-permute,
+// clamp delta via per-original-row CSR. Each output element is written exactly once (no atomics).
+#include "vr-native-cpu.h"
+#include "ggml-cpu-impl.h"
+#include "vr-native-cpu-core.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#define VRC_NCB 64   // columns per work item in the batch path (decoded tile reused across them)
+
+bool ggml_vr_cpu_env(void) {
+    static int v = -1;
+    if (v < 0) { const char * e = getenv("GGML_VR_NATIVE"); v = e && atoi(e) == 1; }
+    return v == 1;
+}
+bool ggml_vr_cpu_slot(const struct ggml_tensor * t) {
+    switch (t->type) {
+        case GGML_TYPE_IQ2_XXS: case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K: break;
+        default: return false;
+    }
+    return t->ne[0] % 256 == 0 && t->ne[1] % 32 == 0 && t->ne[1] < 32768 && t->ne[2] == 1 && t->ne[3] == 1 && ggml_is_contiguous(t) && !t->view_src;
+}
+bool ggml_vr_cpu_linear_name(const char * nm) {
+    if (!nm || strncmp(nm, "blk.", 4)) return false;
+    static const char * suf[] = { ".attn_q.weight", ".attn_k.weight", ".attn_v.weight", ".attn_output.weight", ".ffn_gate.weight", ".ffn_up.weight", ".ffn_down.weight" };
+    const size_t n = strlen(nm);
+    for (int i = 0; i < 7; ++i) { const size_t s = strlen(suf[i]); if (n > s && !strcmp(nm + n - s, suf[i])) return true; }
+    return false;
+}
+// R53: per-tensor-kind precision mask GGML_VR_X16_MASK (bit 0 q, 1 k, 2 v, 3 o, 4 gate, 5 up, 6 down; default 127 = all x16)
+static int vrc_kind(const struct ggml_tensor * t) {
+    static const char * suf[] = { ".attn_q.weight", ".attn_k.weight", ".attn_v.weight", ".attn_output.weight", ".ffn_gate.weight", ".ffn_up.weight", ".ffn_down.weight" };
+    const char * nm = ggml_get_name(t); const size_t n = strlen(nm);
+    for (int i = 0; i < 7; ++i) { const size_t sl = strlen(suf[i]); if (n > sl && !strcmp(nm + n - sl, suf[i])) return i; }
+    return 7;
+}
+static int vrc_x16_kind(const struct ggml_tensor * t) {
+    static int mask = -1; if (mask < 0) { const char * e = getenv("GGML_VR_X16_MASK"); mask = e ? (int)strtol(e, NULL, 0) : 127; }
+    const int k = vrc_kind(t); return k < 7 ? (mask >> k) & 1 : 1;
+}
+static int vrc_x16(int64_t N) {   // precision mode for the batch path: GGML_VR_CPU_X16 = 0 off, 1 batch only (default), 2 always
+    static int v = -1; if (v < 0) { const char * e = getenv("GGML_VR_CPU_X16"); v = e ? atoi(e) : 1; }
+    return v == 2 || (v == 1 && N > 1);
+}
+static size_t vrc_ws(int64_t K, int64_t N) { const int64_t nsl = K / 128; return (size_t)2 * N * nsl * (256 + 8) + 256; }
+size_t ggml_vr_cpu_wsize(const struct ggml_tensor * node) {
+    if (!ggml_vr_cpu_env() || !node->src[0] || !node->src[1] || !ggml_vr_cpu_slot(node->src[0])) return 0;
+    return vrc_ws(node->src[0]->ne[0], node->src[1]->ne[1]);
+}
+
+// registry: data pointer -> meta (NULL meta = probed, not a VR tensor)
+#define VRC_REG 2048
+static struct { const void * _Atomic key; vrc_meta * m; } g_reg[VRC_REG];
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static int g_hello = 0;
+static vrc_meta * vrc_get(const struct ggml_tensor * t) {
+    {   // R53: lock-free hit path (entries are write-once; key published with release after m)
+        size_t h = ((uintptr_t)t->data >> 6) % VRC_REG;
+        for (;;) {
+            const void * k = atomic_load_explicit(&g_reg[h].key, memory_order_acquire);
+            if (k == t->data) return g_reg[h].m;
+            if (!k) break;
+            h = (h + 1) % VRC_REG;
+        }
+    }
+    pthread_mutex_lock(&g_mu);
+    size_t h = ((uintptr_t)t->data >> 6) % VRC_REG;
+    for (;;) {
+        const void * k = atomic_load_explicit(&g_reg[h].key, memory_order_relaxed);
+        if (k == t->data) { vrc_meta * m = g_reg[h].m; pthread_mutex_unlock(&g_mu); return m; }
+        if (!k) break;
+        h = (h + 1) % VRC_REG;
+    }
+    vrc_meta * m = NULL;
+    const size_t n = ggml_nbytes(t);
+    if (vrc_probe((const uint8_t *)t->data, n, (int)t->ne[1], (int)t->ne[0])) {
+        m = (vrc_meta *)malloc(sizeof(vrc_meta));
+        const int rc = vrc_init(m, (const uint8_t *)t->data, n, (int)t->ne[1], (int)t->ne[0]);
+        if (rc) { fprintf(stderr, "VR native CPU: %s: bad tensor (rc %d)\n", ggml_get_name(t), rc); GGML_ABORT("VR native CPU"); }
+        if (!g_hello) { g_hello = 1; fprintf(stderr, "VR native CPU: Pingala-8 (NS 108) decode active (%s), first tensor %s, c = %08x\n",
+#if defined(__AVXVNNI__)
+            "AVX2+AVX-VNNI",
+#elif defined(__AVX2__)
+            "AVX2",
+#elif defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+            "NEON+dotprod",
+#elif defined(__ARM_NEON)
+            "NEON",
+#else
+            "scalar",
+#endif
+            ggml_get_name(t), m->cs); }
+    } else if (t->type == GGML_TYPE_IQ2_XXS || ggml_vr_cpu_linear_name(ggml_get_name(t))) {
+        fprintf(stderr, "VR native CPU: %s has no R51 trailer (GGML_VR_NATIVE=1 needs the r51 native file)\n", ggml_get_name(t));
+        GGML_ABORT("VR native CPU");
+    }
+    g_reg[h].m = m; atomic_store_explicit(&g_reg[h].key, t->data, memory_order_release);
+    pthread_mutex_unlock(&g_mu);
+    return m;
+}
+
+static void vrp_vr(const struct ggml_tensor * dst, int64_t p1, int64_t busy, int nth);
+// ---- R53 tg path (N = 1): v4 kernel (coset out of the gather), x16 activations by default (the ppl-gate mode), and the prepared
+// activation cached across consecutive mul_mats with the same input tensor and the same column scale c (q/k/v, gate/up) in one graph.
+static _Atomic unsigned g_epoch = 0;
+// per-call work counters: call c of a graph uses slot c & 63; thread 0 zeroes slot c+1 during call c (every node ends in a pool barrier,
+// so nobody touches slot c+1 before call c+1). No reset barrier needed on a cache hit.
+static _Atomic int g_cnt[64];
+static _Thread_local unsigned t_epoch = 0; static _Thread_local unsigned t_call = 0;
+void ggml_vr_cpu_graph_begin(void) { atomic_fetch_add_explicit(&g_epoch, 1, memory_order_relaxed); atomic_store_explicit(&g_cnt[0], 0, memory_order_relaxed); }
+#if defined(VRC_V4)
+#define VRC_TG_MAXSL 256   // K <= 32768
+static struct {
+    unsigned epoch; const void * t; const void * data; uint64_t chash; int np, K;   // key (written by thread 0 after the phase-1 barrier)
+    _Alignas(64) int8_t X[2 * VRC_TG_MAXSL * 256]; float XS[2 * VRC_TG_MAXSL]; int32_t SX[2 * VRC_TG_MAXSL]; _Alignas(64) uint32_t LH[2 * VRC_TG_MAXSL * 16];   // plane p at p * nsl (contiguous)
+} g_tg;
+static int vrc_tg_v3(void) { static int v = -1; if (v < 0) { const char * e = getenv("GGML_VR_TG_V3"); v = e && atoi(e) == 1; } return v; }   // R52 tg path (A/B)
+static int vrc_tg_np(void) {   // planes: GGML_VR_CPU_X16 = 0 -> q8 (1 plane), else x16 (2 planes; default, the mode that passes the ppl gate)
+    static int v = -1; if (v < 0) { const char * e = getenv("GGML_VR_CPU_X16"); v = e ? atoi(e) : 2; }
+    return v == 0 ? 1 : 2;
+}
+static void vrc_tg(const struct ggml_compute_params * params, struct ggml_tensor * dst, const vrc_meta * m, int64_t vt0) {
+    const struct ggml_tensor * src1 = dst->src[1];
+    const int ith = params->ith, nth = params->nth, nb = m->nb, np = vrc_tg_np() == 2 && vrc_x16_kind(dst->src[0]) ? 2 : 1;
+    const float * x = (const float *)src1->data;
+    const unsigned ep = atomic_load_explicit(&g_epoch, memory_order_relaxed);
+    if (t_epoch != ep) { t_epoch = ep; t_call = 0; }
+    const unsigned call = t_call++;
+    if (ith == 0) atomic_store_explicit(&g_cnt[(call + 1) & 63], 0, memory_order_relaxed);
+    _Atomic int * cnt = &g_cnt[call & 63];
+    const size_t xps = (size_t)m->nsl * 256, sps = (size_t)m->nsl, lhs = (size_t)m->nsl * 16;   // plane strides (contiguous planes)
+    const bool hit = g_tg.epoch == ep && g_tg.t == (const void *)src1 && g_tg.data == src1->data && g_tg.chash == m->chash && g_tg.np == np && g_tg.K == m->K;
+    if (!hit) {
+        for (int b = ith; b < nb; b += nth) {
+            if (np == 2) vrc_prep_block16(m, x, b, g_tg.X + (size_t)2 * b * 256, g_tg.XS + 2 * b, g_tg.SX + 2 * b, g_tg.X + xps + (size_t)2 * b * 256, g_tg.XS + sps + 2 * b, g_tg.SX + sps + 2 * b);
+            else vrc_prep_block(m, x, b, g_tg.X + (size_t)2 * b * 256, g_tg.XS + 2 * b, g_tg.SX + 2 * b);
+            for (int p = 0; p < np; ++p) for (int hs = 0; hs < 2; ++hs) vrc_prep_cx(m->cs, g_tg.X + p * xps + (size_t)(2 * b + hs) * 256, g_tg.LH + p * lhs + (size_t)(2 * b + hs) * 16);
+        }
+        ggml_barrier(params->threadpool);
+        if (ith == 0) { g_tg.epoch = ep; g_tg.t = src1; g_tg.data = src1->data; g_tg.chash = m->chash; g_tg.np = np; g_tg.K = m->K; }
+    }   // hit: activation prepared by an earlier call of this graph (visible: every node ends in a pool barrier); no barrier
+    const int64_t vt1 = vt0 ? ggml_vr_prof_ns() : 0;
+    const size_t ldy = dst->nb[1] / sizeof(float); (void)ldy;
+    float * y = (float *)dst->data;
+    _Alignas(64) float accY[32];
+    int it = ith;
+    while (it < m->ng) {
+        const int g = it;
+        memset(accY, 0, sizeof accY);
+        if (np == 2) for (int b = 0; b < nb; ++b) vrc_tile_v4x(m, g, b, g_tg.X, xps, g_tg.XS, g_tg.SX, sps, g_tg.LH, lhs, accY);
+        else for (int b = 0; b < nb; ++b) vrc_tile_v4(m, g, b, g_tg.X, g_tg.XS, g_tg.SX, g_tg.LH, accY);
+        for (int j = 0; j < 32; ++j) {
+            const int ro = m->prm[g * 32 + j]; float a = accY[j];
+            for (int e = m->cp[ro]; e < m->cp[ro + 1]; ++e) a += m->cv[e] * x[m->cc[e]];
+            y[ro] = a;
+        }
+        it = nth + atomic_fetch_add_explicit(cnt, 1, memory_order_relaxed);
+    }
+    if (vt0) vrp_vr(dst, ith == 0 ? vt1 - vt0 : -1, ggml_vr_prof_ns() - vt1, nth);
+}
+#endif
+bool ggml_vr_cpu_mul_mat(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    if (!ggml_vr_cpu_env()) return false;
+    const int64_t vt0 = ggml_vr_prof_on() ? ggml_vr_prof_ns() : 0;
+    const struct ggml_tensor * src0 = dst->src[0], * src1 = dst->src[1];
+    if (!ggml_vr_cpu_slot(src0) || src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->nb[0] != sizeof(float)) return false;
+    vrc_meta * m = vrc_get(src0);
+    if (!m) return false;
+    const int ith = params->ith, nth = params->nth, N = (int)src1->ne[1], K = m->K, nsl = m->nsl, nb = m->nb;
+#if defined(VRC_V4)
+    if (N == 1 && nsl <= VRC_TG_MAXSL && !vrc_tg_v3()) { vrc_tg(params, dst, m, vt0); return true; }
+#endif
+    GGML_ASSERT(params->wsize >= vrc_ws(K, N) && dst->nb[0] == sizeof(float));
+    int8_t * X2 = (int8_t *)params->wdata;
+    float * XS = (float *)(X2 + (size_t)N * nsl * 256);
+    int32_t * SX = (int32_t *)(XS + (size_t)N * nsl);
+    const size_t ldx = src1->nb[1] / sizeof(float), ldy = dst->nb[1] / sizeof(float);
+    // phase 1: activation transform + quantize
+    const int x16 = vrc_x16(N) && vrc_x16_kind(src0), NV = x16 ? 2 * N : N;   // virtual columns (x16: hi, lo planes of each column)
+    XS = (float *)(X2 + (size_t)NV * nsl * 256); SX = (int32_t *)(XS + (size_t)NV * nsl);
+    const int units = N * nb;
+    for (int u = ith; u < units; u += nth) {
+        const int n = u / nb, b = u % nb;
+        const float * xc = (const float *)src1->data + (size_t)n * ldx;
+        if (x16) vrc_prep_block16(m, xc, b, X2 + ((size_t)(2 * n) * nsl + 2 * b) * 256, XS + (size_t)(2 * n) * nsl + 2 * b, SX + (size_t)(2 * n) * nsl + 2 * b,
+                                 X2 + ((size_t)(2 * n + 1) * nsl + 2 * b) * 256, XS + (size_t)(2 * n + 1) * nsl + 2 * b, SX + (size_t)(2 * n + 1) * nsl + 2 * b);
+        else vrc_prep_block(m, xc, b, X2 + ((size_t)n * nsl + 2 * b) * 256, XS + (size_t)n * nsl + 2 * b, SX + (size_t)n * nsl + 2 * b);
+    }
+    if (ith == 0) ggml_threadpool_chunk_set(params->threadpool, nth);
+    ggml_barrier(params->threadpool);
+    const int64_t vt1 = vt0 ? ggml_vr_prof_ns() : 0;
+    // phase 2
+    const int ncb = NV == 1 ? 1 : VRC_NCB, ncblk = (NV + ncb - 1) / ncb, items = m->ng * ncblk;   // ncb even: hi/lo pairs stay together
+    _Alignas(64) uint8_t tb[64 * 3 * 128];
+    _Alignas(64) float accY[VRC_NCB * 32];
+#if defined(__AVX2__)
+    __m256i tbv[96], acci[VRC_NCB];
+#endif
+    int it = ith;
+    while (it < items) {
+        const int g = it % m->ng, cb = it / m->ng, n0 = cb * ncb, nc = NV - n0 < ncb ? NV - n0 : ncb;
+        memset(accY, 0, sizeof(float) * 32 * nc);
+#if defined(__AVX2__)
+        for (int b = 0; b < nb; ++b) vrc_tile_ls(m, g, b, nc, X2 + (size_t)n0 * nsl * 256, XS + (size_t)n0 * nsl, SX + (size_t)n0 * nsl, accY, tbv, acci);   // v2 lane-SIMD
+#else
+        for (int b = 0; b < nb; ++b) vrc_tile(m, g, b, nc, X2 + (size_t)n0 * nsl * 256, XS + (size_t)n0 * nsl, SX + (size_t)n0 * nsl, accY, tb);
+#endif
+        for (int j = 0; j < 32; ++j) {
+            const int ro = m->prm[g * 32 + j], e0 = m->cp[ro], e1 = m->cp[ro + 1];
+            const int st = x16 ? 2 : 1;
+            for (int nn = 0; nn < nc; nn += st) {
+                float a = x16 ? accY[nn * 32 + j] + accY[(nn + 1) * 32 + j] : accY[nn * 32 + j];
+                const int col = (n0 + nn) / st;
+                const float * xr = (const float *)src1->data + (size_t)col * ldx;
+                for (int e = e0; e < e1; ++e) a += m->cv[e] * xr[m->cc[e]];
+                ((float *)dst->data)[(size_t)col * ldy + ro] = a;
+            }
+        }
+        it = ggml_threadpool_chunk_add(params->threadpool, 1);
+    }
+    if (vt0) vrp_vr(dst, ith == 0 ? vt1 - vt0 : -1, ggml_vr_prof_ns() - vt1, nth);
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------- R53 tg profiler (GGML_VR_PROF=1)
+// Thread 0 times each graph node from its start to after the following barrier (= wall time of that node for the whole pool).
+// VR mul_mat also records: phase-1 wall (thread 0, incl. barrier), phase-2 busy time summed over threads (for the imbalance).
+#include <time.h>
+#include <stdatomic.h>
+#define VRP_N 96
+static struct { char key[48]; int64_t ns, n, p1, busy, nth; } g_vrp[VRP_N];
+static int64_t g_vrp_graphs = 0, g_vrp_t0 = 0, g_vrp_tot = 0;
+bool ggml_vr_prof_on(void) { static int v = -1; if (v < 0) { const char * e = getenv("GGML_VR_PROF"); v = e && atoi(e) == 1; } return v == 1; }
+int64_t ggml_vr_prof_ns(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec; }
+static void vrp_key(const struct ggml_tensor * node, char * k) {
+    if (node->op == GGML_OP_MUL_MAT && node->src[0]) {
+        const char * nm = ggml_get_name(node->src[0]); const char * d = strrchr(nm, '.'); const char * s = nm;
+        if (d && d > nm) { const char * q = d - 1; while (q > nm && *q != '.') --q; s = *q == '.' ? q + 1 : q; }
+        char suf[32]; snprintf(suf, sizeof suf, "%.*s", (int)(d && d > s ? d - s : (int)strlen(s)), s);
+        const bool vr = ggml_vr_cpu_env() && ggml_vr_cpu_slot(node->src[0]) && node->src[0]->data && vrc_probe((const uint8_t *)node->src[0]->data, ggml_nbytes(node->src[0]), (int)node->src[0]->ne[1], (int)node->src[0]->ne[0]);
+        snprintf(k, 48, "MM %s %s", suf, vr ? "VR" : ggml_type_name(node->src[0]->type));
+    } else snprintf(k, 48, "%s", ggml_op_desc(node));
+}
+static int vrp_slot(const char * k) {
+    for (int i = 0; i < VRP_N; ++i) { if (!g_vrp[i].key[0]) { snprintf(g_vrp[i].key, 48, "%s", k); return i; } if (!strcmp(g_vrp[i].key, k)) return i; }
+    return VRP_N - 1;
+}
+static void vrp_dump(void) {
+    if (!g_vrp_graphs) return;
+    const double G = (double)g_vrp_graphs; double tot = 0; for (int i = 0; i < VRP_N; ++i) tot += g_vrp[i].ns;
+    fprintf(stderr, "VRPROF graphs %lld, node wall %.3f ms/graph, graph-to-graph %.3f ms/graph\n", (long long)g_vrp_graphs, tot / G * 1e-6, g_vrp_tot / G * 1e-6);
+    for (int i = 0; i < VRP_N && g_vrp[i].key[0]; ++i) {
+        const double ms = g_vrp[i].ns / G * 1e-6;
+        fprintf(stderr, "VRPROF %-28s %8.3f ms/graph %5.1f%%  calls/graph %5.1f", g_vrp[i].key, ms, 100.0 * g_vrp[i].ns / tot, g_vrp[i].n / G);
+        if (g_vrp[i].nth) fprintf(stderr, "  p1 %.3f ms  p2-busy-mean %.3f ms  (eff %.0f%%)", g_vrp[i].p1 / G * 1e-6, g_vrp[i].busy / (double)g_vrp[i].nth / G * 1e-6,
+                                  100.0 * (g_vrp[i].busy / (double)g_vrp[i].nth) / (double)(g_vrp[i].ns - g_vrp[i].p1));
+        fprintf(stderr, "\n");
+    }
+}
+void ggml_vr_prof_node(const struct ggml_tensor * node, int n_fused, int64_t ns, bool first) {
+    static int reg = 0; if (!reg) { reg = 1; atexit(vrp_dump); }
+    if (first) { const int64_t t = ggml_vr_prof_ns(); if (g_vrp_t0) { g_vrp_tot += t - g_vrp_t0; } g_vrp_t0 = t; g_vrp_graphs++; }
+    char k[48]; vrp_key(node, k); if (n_fused > 0) { size_t l = strlen(k); snprintf(k + l, 48 - l, "+fused"); }
+    const int i = vrp_slot(k); g_vrp[i].ns += ns; g_vrp[i].n++;
+}
+// called from the VR mul_mat (thread 0: p1; every thread: busy)
+static void vrp_vr(const struct ggml_tensor * dst, int64_t p1, int64_t busy, int nth) {
+    char k[48]; vrp_key(dst, k);
+    pthread_mutex_lock(&g_mu); const int i = vrp_slot(k);
+    if (p1 >= 0) g_vrp[i].p1 += p1;
+    g_vrp[i].busy += busy; g_vrp[i].nth = nth;   // busy summed over threads and calls
+    pthread_mutex_unlock(&g_mu);
+}
