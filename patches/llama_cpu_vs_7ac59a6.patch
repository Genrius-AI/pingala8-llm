+                case 2: vrc_v4_half(2, NP, ph, lg, m->A2, xh, xps, LHp, a); break;
+                case 3: vrc_v4_half(3, NP, ph, lg, m->A2, xh, xps, LHp, a); break;
+                case 4: vrc_v4_half(4, NP, ph, lg, m->A2, xh, xps, LHp, a); break;
+                case 5: vrc_v4_half(5, NP, ph, lg, m->A2, xh, xps, LHp, a); break;
+                case 6: vrc_v4_half(6, NP, ph, lg, m->A2, xh, xps, LHp, a); break;
