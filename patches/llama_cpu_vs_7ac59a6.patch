+    if (split == 2) { for (int q = 0; q < 128; ++q) row[q] = 0; } else
+    switch (c) {
+        case 1: k1_dec<1>(p, lane, As, cs, row); break; case 2: k1_dec<2>(p, lane, As, cs, row); break;
+        case 3: k1_dec<3>(p, lane, As, cs, row); break; case 4: k1_dec<4>(p, lane, As, cs, row); break;
+        case 5: k1_dec<5>(p, lane, As, cs, row); break; case 6: k1_dec<6>(p, lane, As, cs, row); break;
+        case 7: k1_dec<7>(p, lane, As, cs, row); break;
+        default: for (int q = 0; q < 128; ++q) row[q] = 0; break;
+    }
+    __syncthreads();
