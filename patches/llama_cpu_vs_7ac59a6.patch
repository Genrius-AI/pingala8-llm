+const short * g_vr_prm = nullptr;   // R51 real format: row permutation for the current VR MMQ call (read by mmq.cuh launch_mul_mat_q)
+// R51b per-phase timing (GGML_VR_PROF=1; cudaEvents, synchronises after every VR batch matmul: timing only, not for benches)
+static int r51_prof() { static const int m = [] { const char * e = getenv("GGML_VR_PROF"); return e ? atoi(e) : 0; }(); return m; }
+struct r51_prof_acc { double ph[4] = {0, 0, 0, 0}; long n = 0; long cols = 0;
+    ~r51_prof_acc() { if (n) { const double ub = (double)n / 212.0;   // 212 VR matmuls per ubatch
