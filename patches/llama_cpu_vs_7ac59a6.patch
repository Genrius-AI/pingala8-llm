+    for (int p = 0; p < NP; ++p) for (int r = 0; r < 4; ++r) {
+        int32x4_t a = vshlq_s32(acc[p][0][r], vdupq_n_s32(S1));
+        if (nst > 1) a = vaddq_s32(a, vshlq_s32(acc[p][1][r], vdupq_n_s32(S2)));
+        if (nst > 2) a = vaddq_s32(a, acc[p][2][r]);
+        out[p][r] = vmlaq_s32(a, corr[p][r], vdupq_n_s32(MC));
+    }
+#undef VRC_LW
+}
+static inline __attribute__((always_inline)) void vrc_tile_v4_np(const int NP, const vrc_meta * m, int g, int b, const int8_t * X2, size_t xps, const float * XS, const int32_t * SX, size_t sps,
+        const uint32_t * LHall, size_t lhs, float * accY) {
+    (void)SX;
+    const uint32_t mt = m->M[(size_t)g * m->nb + b]; const int c = (int)(mt >> 29);
+    {
+        const size_t tn = (size_t)g * m->nb + b + 1;
+        if (tn < (size_t)m->ng * m->nb) { const uint32_t mn = m->M[tn]; const char * pn = (const char *)(m->D + (mn & 0x1FFFFFFFu)); const int nbytes = 2 * vrc_NW((int)(mn >> 29)) * 32 * 4;
+            for (int o = 0; o < nbytes; o += 64) __builtin_prefetch(pn + o, 0, 3); }
+    }
+    if (!c) return;
+    const int NW = vrc_NW(c);
+    const uint32_t * p0 = m->D + (mt & 0x1FFFFFFFu);
+    const uint16_t * Sr = m->S + (size_t)b * m->rows + (size_t)g * 32;
+    for (int hs = 0; hs < 2; ++hs) {
+        const uint32_t * ph = p0 + (size_t)hs * NW * 32;
+        const int8_t * xh = X2 + (size_t)(2 * b + hs) * 256;
+        uint32_t LHc[32]; memcpy(LHc, LHall + (size_t)(2 * b + hs) * 16, 64); if (NP == 2) memcpy(LHc + 16, LHall + lhs + (size_t)(2 * b + hs) * 16, 64);
+        const float xs0 = XS[2 * b + hs], xs1 = NP == 2 ? XS[sps + 2 * b + hs] : 0.f;
+        for (int lg16 = 0; lg16 < 2; ++lg16) {
+            int32x4_t a[2][4];
+            switch (c) {
+                case 1: vrc_v4n_half(1, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                case 2: vrc_v4n_half(2, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                case 3: vrc_v4n_half(3, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                case 4: vrc_v4n_half(4, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                case 5: vrc_v4n_half(5, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                case 6: vrc_v4n_half(6, NP, ph, lg16, m, xh, xps, LHc, a); break;
+                default: vrc_v4n_half(7, NP, ph, lg16, m, xh, xps, LHc, a); break;
+            }
+            for (int r = 0; r < 4; ++r) {
+                const int j0 = 16 * lg16 + 4 * r;
+                float sc[4]; for (int l = 0; l < 4; ++l) sc[l] = vrc_h2f(Sr[j0 + l]);
+                float32x4_t f = vmulq_n_f32(vcvtq_f32_s32(a[0][r]), xs0);
+                if (NP == 2) f = vaddq_f32(f, vmulq_n_f32(vcvtq_f32_s32(a[1][r]), xs1));
