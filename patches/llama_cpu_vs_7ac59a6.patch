+    std::vector<std::string> bases;
+    for (const auto & it : weights_map) {
+        if (vr_ends_with(it.first, ".vr_c")) bases.push_back(it.first.substr(0, it.first.size() - 5));
+    }
+    static const ggml_type slots[] = { GGML_TYPE_IQ2_XXS, GGML_TYPE_Q2_K, GGML_TYPE_Q3_K, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q6_K };   // = vr49.cuh vr_native_slot
+    size_t mem = 0;
+    for (const auto & b : bases) {
+        const std::string wn = b + ".weight";
+        const auto wit = weights_map.find(wn);
+        if (wit == weights_map.end()) throw std::runtime_error(format("VR native: '%s' has vr_c but no weight", b.c_str()));
+        ggml_tensor * t = wit->second.tensor;
+        if (t->type != GGML_TYPE_I8 || ggml_n_dims(t) != 1) throw std::runtime_error(format("VR native: '%s' must be I8 1-D", wn.c_str()));
+        vr_native_tensor vt;
+        vt.side.push_back(take(b + ".vr_c"));
+        vt.side.push_back(take(b + ".vr_prm"));
+        const ggml_tensor * tc = vt.side[0].tensor, * tp = vt.side[1].tensor;
+        if (tc->type != GGML_TYPE_F16 || tp->type != GGML_TYPE_I16) throw std::runtime_error(format("VR native: '%s' vr_c F16 / vr_prm I16 expected", b.c_str()));
+        vt.K = tc->ne[0]; vt.rows = tp->ne[0]; vt.kbytes = (size_t) t->ne[0];
+        if (vt.K % 256 || vt.rows % 32 || vt.rows >= 32768) throw std::runtime_error(format("VR native: '%s' bad shape K %lld rows %lld", b.c_str(), (long long) vt.K, (long long) vt.rows));
+        const bool has_d = weights_map.count(b + ".vr_didx") > 0;
+        if (has_d != (weights_map.count(b + ".vr_dval") > 0)) throw std::runtime_error(format("VR native: '%s' needs both vr_didx and vr_dval", b.c_str()));
+        if (has_d) {
+            vt.side.push_back(take(b + ".vr_didx"));
+            vt.side.push_back(take(b + ".vr_dval"));
+            const ggml_tensor * ti = vt.side[2].tensor, * tv = vt.side[3].tensor;
+            vt.nd = tv->ne[0];
+            if (ti->type != GGML_TYPE_I16 || tv->type != GGML_TYPE_F32 || ti->ne[0] != vt.nd || ti->ne[1] != 2) {
+                throw std::runtime_error(format("VR native: '%s' vr_didx I16 [nd,2] / vr_dval F32 [nd] expected", b.c_str()));
+            }
+        }
+        const size_t need = vrn_need(vt.kbytes, vt.rows, vt.K, vt.nd);
+        for (ggml_type st : slots) {
+            if (ggml_row_size(st, vt.K) * vt.rows >= need) { vt.slot = st; break; }
+        }
+        if (vt.slot == GGML_TYPE_COUNT) throw std::runtime_error(format("VR native: '%s' needs %zu B, no slot type fits", wn.c_str(), need));
+        // retype the META tensor in place: logical shape [K, rows] in the slot type (the model tensor is ggml_dup_tensor of it)
+        t->type = vt.slot; t->ne[0] = vt.K; t->ne[1] = vt.rows; t->ne[2] = t->ne[3] = 1;
+        t->nb[0] = ggml_type_size(vt.slot); t->nb[1] = ggml_row_size(vt.slot, vt.K); t->nb[2] = t->nb[1] * vt.rows; t->nb[3] = t->nb[2];
+        mem += ggml_nbytes(t);
+        vr_tensors.emplace(wn, std::move(vt));
+    }
+    vr_signs.push_back(take("vr.had_signs"));
+    if (vr_signs[0].tensor->type != GGML_TYPE_I8 || vr_signs[0].tensor->ne[0] != 256) throw std::runtime_error("VR native: vr.had_signs must be I8 [256]");
+    if (vr_tensors.size() != n_linear || n_linear != 7u * (uint32_t) n_layer_vr) {   // R51 load-time assert; gemma3 port: count from vr.n_linear = 7 x n_layer (Qwen3-4B 252, Gemma-3-4B 238)
+        throw std::runtime_error(format("VR native: %zu VR tensors, vr.n_linear %u, expected 7 x %u", vr_tensors.size(), n_linear, (uint32_t) n_layer_vr));
+    }
+    LLAMA_LOG_INFO("%s: VR native (Pingala-8, NS %u): %zu linears retyped to slots, %.2f MiB in memory\n", __func__, ns, vr_tensors.size(), mem / 1048576.0);
+}
+
+size_t llama_model_loader::vr_file_nbytes(const std::string & name, const ggml_tensor * t) const {
+    const auto it = vr_tensors.find(name);
+    return it == vr_tensors.end() ? ggml_nbytes(t) : it->second.kbytes;
+}
+
+void llama_model_loader::vr_read_weight(const llama_tensor_weight & w, size_t n, void * dst) const {
+    if (use_mmap) {
+        memcpy(dst, (const uint8_t *) mappings.at(w.idx)->addr() + w.offs, n);
+    } else {
+        const auto & file = files.at(w.idx);
+        file->seek(w.offs, SEEK_SET);
+        file->read_raw(dst, n);
+    }
+}
+
+void llama_model_loader::vr_native_load(const std::string & name, const vr_native_tensor & vt, ggml_tensor * cur) const {
+    if (cur->buffer == nullptr) {   // R52: host (CPU) buffers are fine (ggml-cpu vr-native-cpu.c); mmap'd weights are not (use --no-mmap)
+        throw std::runtime_error(format("VR native: '%s' has no buffer (run with --no-mmap / -mmp 0)", name.c_str()));
+    }
+    const size_t n = ggml_nbytes(cur);
+    std::vector<uint8_t> buf(n, 0);
+    const auto & w = require_weight(name.c_str());
+    vr_read_weight(w, vt.kbytes, buf.data());
+    const uint32_t * hw = (const uint32_t *) buf.data();
+    if (hw[513] != VRN_NS || hw[514] != VRN_TRL) {
+        throw std::runtime_error(format("VR native: '%s' header NS %u TRL %u (need %u / %u)", name.c_str(), hw[513], hw[514], VRN_NS, VRN_TRL));
+    }
+    if (vr_hdr0.empty()) vr_hdr0.assign(buf.begin(), buf.begin() + 2052);
+    else if (memcmp(vr_hdr0.data(), buf.data(), 2052) != 0) throw std::runtime_error(format("VR native: '%s' tables (A, B, c) differ from the first tensor", name.c_str()));
+    const size_t nt = (size_t) (vt.rows / 32) * (vt.K / 256);
+    if (2064 + 4 * nt > vt.kbytes) throw std::runtime_error(format("VR native: '%s' too short for M", name.c_str()));
+    const size_t want = vrn_kbytes(vt.rows, vt.K, vrn_payload_words((const uint32_t *) (buf.data() + 2064), nt));
+    if (want != vt.kbytes) {   // R51 load-time assert: per-tensor byte size == layout implied by its own M words
+        throw std::runtime_error(format("VR native: '%s' has %zu B, its M words imply %zu B", name.c_str(), vt.kbytes, want));
+    }
+    size_t offE, offC, offP, offQ, offSG, offT;
+    vrn_offsets(n, vt.rows, vt.K, vt.nd, &offE, &offC, &offP, &offQ, &offSG, &offT);
+    GGML_ASSERT(vt.kbytes <= offE);
+    vr_read_weight(vt.side[0], (size_t) 2 * vt.K, buf.data() + offC);
+    vr_read_weight(vt.side[1], (size_t) 2 * vt.rows, buf.data() + offP);
+    {   // prm must be a permutation of 0..rows-1
+        std::vector<uint8_t> seen(vt.rows, 0); const int16_t * p = (const int16_t *) (buf.data() + offP);
+        for (int64_t r = 0; r < vt.rows; ++r) { if (p[r] < 0 || p[r] >= vt.rows || seen[p[r]]++) throw std::runtime_error(format("VR native: '%s' vr_prm is not a permutation", name.c_str())); }
+        int16_t * q = (int16_t *) (buf.data() + offQ);   // inverse permutation (original -> sorted) for the gather un-permute (vr49.cuh k_vr_gather)
+        for (int64_t r = 0; r < vt.rows; ++r) q[p[r]] = (int16_t) r;
+    }
+    if (vt.nd > 0) {   // vr_didx I16 [nd,2]: first nd = original rows, next nd = original cols (u16); vr_dval F32 [nd]
+        vr_read_weight(vt.side[2], (size_t) 4 * vt.nd, buf.data() + offE);
+        vr_read_weight(vt.side[3], (size_t) 4 * vt.nd, buf.data() + offE + (size_t) 4 * vt.nd);
+        const uint16_t * dr = (const uint16_t *) (buf.data() + offE), * dc = dr + vt.nd;
+        for (int64_t e = 0; e < vt.nd; ++e) { if (dr[e] >= vt.rows || dc[e] >= vt.K) throw std::runtime_error(format("VR native: '%s' delta index out of range", name.c_str())); }
+    }
+    vr_read_weight(vr_signs[0], 256, buf.data() + offSG);
+    for (int i = 0; i < 256; ++i) { const int8_t v = (int8_t) buf[offSG + i]; if (v != 1 && v != -1) throw std::runtime_error("VR native: vr.had_signs must be +-1"); }
+    const vrn_trailer tr = { VRN_MAGIC0, VRN_MAGIC1, (uint32_t) vt.kbytes, (uint32_t) vt.nd, (uint32_t) vt.rows, (uint32_t) vt.K, VRN_NS, 1u };
+    memcpy(buf.data() + offT, &tr, sizeof(tr));
+    ggml_backend_tensor_set(cur, buf.data(), 0, n);
+}
