+// The native MMQ VR loader (same code, same values) fills one 128-row x 256-col smem tile; it is stored as Q8_0 blocks
+// (fp16 d = loader float d = fp16 tile scale x 2^sh, exact). 17 u16 per block, consecutive threads write consecutive u16.
+template <ggml_type T>
+static __global__ void __launch_bounds__(256) k_r51_to_q8(const char * __restrict__ x, char * __restrict__ y, const int rows, const int nb) {
+    constexpr int I  = ggml_cuda_mmq_get_I(T, 128, true);
+    constexpr int SS = ggml_cuda_mmq_get_sram_stride(T, 128, true);
+    extern __shared__ int r51_tile[];
+    const int it = blockIdx.x, kb = blockIdx.y;
+    ggml_cuda_mmq_load_tiles_vr47<T, 128, true>(x, r51_tile, it * I * nb + kb, rows - it * I - 1, nb);
+    __syncthreads();
+    const int * x_qs = r51_tile; const float * x_df = (const float *)(r51_tile + 2 * MMQ_TILE_NE_K);
+    uint16_t * Y = (uint16_t *)y;
+    for (int e = threadIdx.y * 32 + threadIdx.x; e < I * 136; e += 256) {
+        const int i = e / 136, w = e - i * 136, b = w / 17, w2 = w - b * 17, r = it * I + i;
+        if (r >= rows) break;
+        uint16_t v;
+        if (w2 == 0) { const half d = __float2half(x_df[i * SS + b]); v = *(const uint16_t *)&d; }
+        else { const uint32_t q = (uint32_t)x_qs[i * SS + 8 * b + ((w2 - 1) >> 1)]; v = (uint16_t)(((w2 - 1) & 1) ? (q >> 16) : (q & 0xFFFFu)); }
+        Y[((size_t)r * nb * 8 + (size_t)kb * 8 + b) * 17 + w2] = v;
+    }
+}
+// R51 PPC (prompt path = carrier): decode a VR tensor ONCE per batch matmul into stock Q8_0 in the ORIGINAL weight domain.
+// The exact HL loader fills one 128-row x 256-col smem tile (hi plane + lo plane for class 4-7); each warp then takes one row at a time:
+// v = hi*S*128 + lo*S (exact), W = (H256 v / 16) * sgn / c (warp FWHT), Q8_0 per 32 cols with the gguf rule (d = amax/127 -> fp16,
+// q = rint(w / d)), stored at row prm[r] (un-permute on write). The clamp is not applied here: the f32 delta is added after the MMQ.
+static int r51_ppc() { static const int m = [] { const char * e = getenv("GGML_VR_PPC"); return e ? atoi(e) : 0; }(); return m; }
+static __global__ void __launch_bounds__(256) k_r51_ppc(const char * __restrict__ x2, char * __restrict__ y, const int rows, const int nb,
+                                                       const half * __restrict__ c16, const short * __restrict__ prm) {
+    constexpr ggml_type T = GGML_VR_HL_TYPE;
+    constexpr int I  = ggml_cuda_mmq_get_I(T, 128, true);
+    constexpr int SS = ggml_cuda_mmq_get_sram_stride(T, 128, true);
+    extern __shared__ int ppc_tile[];
+    const int it = blockIdx.x, kb = blockIdx.y;
+    ggml_cuda_mmq_load_tiles_vr47<T, 128, true>(x2, ppc_tile, it * I * nb + kb, rows - it * I - 1, nb);
+    __syncthreads();
+    const int * xq = ppc_tile; const float * xd = (const float *)(ppc_tile + 2 * MMQ_TILE_NE_K);
+    const int * x2q = ppc_tile + I * SS + 256; const float * x2d = (const float *)(x2q + 2 * MMQ_TILE_NE_K); const int * flg = x2q + I * SS;
+    const int lane = threadIdx.x, sub = lane >> 2, k0 = kb * 256 + 8 * lane;
+    const float4 s0 = __ldg((const float4 *)(g_vr_sgn_d + 8 * lane)), s1 = __ldg((const float4 *)(g_vr_sgn_d + 8 * lane + 4));
+    const float sg[8] = {s0.x, s0.y, s0.z, s0.w, s1.x, s1.y, s1.z, s1.w};
+    const uint4 cw = __ldg((const uint4 *)(c16 + k0)); const half2 * ch = (const half2 *)&cw;
+    float ic[8];
+#pragma unroll
+    for (int m = 0; m < 4; ++m) { const float2 c = __half22float2(ch[m]); ic[2 * m] = sg[2 * m] / c.x; ic[2 * m + 1] = sg[2 * m + 1] / c.y; }
+    for (int i = threadIdx.y; i < I; i += 8) {
+        const int r = it * I + i; if (r >= rows) break;
+        const bool hl = flg[i >> 5] != 0;
+        const float dh = xd[i * SS + sub], dl = hl ? x2d[i * SS + sub] : 0.f;
+        float v[8];
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int qi = xq[i * SS + 2 * lane + h], li = hl ? x2q[i * SS + 2 * lane + h] : 0;
+#pragma unroll
+            for (int e = 0; e < 4; ++e) v[4 * h + e] = (float)(int8_t)(qi >> (8 * e)) * dh + (float)(int8_t)(li >> (8 * e)) * dl;
+        }
+        vr_fwht_warp(v);
+        float am = 0.f;
+#pragma unroll
+        for (int m = 0; m < 8; ++m) { v[m] *= ic[m]; am = fmaxf(am, fabsf(v[m])); }
+        am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, 1)); am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, 2));
+        const float d = am / 127.f, id = d != 0.f ? 1.f / d : 0.f;
+        char * blk = y + ((size_t)prm[r] * nb * 8 + (size_t)kb * 8 + sub) * 34;
+        if ((lane & 3) == 0) *(half *)blk = __float2half(d);
+        uint16_t * qd = (uint16_t *)(blk + 2 + (lane & 3) * 8);
+#pragma unroll
+        for (int m = 0; m < 4; ++m) qd[m] = (uint16_t)((uint8_t)(int8_t)__float2int_rn(v[2 * m] * id) | (uint16_t)(uint8_t)(int8_t)__float2int_rn(v[2 * m + 1] * id) << 8);
+    }
+}
+// R51 PPC step 1, K1 in k_vr style: one CTA = (256-col block b, 32-row tile g), 2 warps = the 2 half-slices; lane = row.
+// Phase 1: each lane reads its lane-slice words straight from the native D layout (no re-layout pass), walks the 32 steps with the
+// Pingala-8 coset trellis (h = u_{t-2} via vr_ung_hk) and writes exact int values into smem [row][col] (int16, |v| <= 1785).
+// Phase 2: each warp takes rows: W = (H256 (v*S) / 16) * sgn / c (warp FWHT), + clamp delta (CSR, original row), Q8_0 (gguf rule), row prm[r].
+template <int W, int WB, int k, int NWT> static __device__ __forceinline__ u32 k1_fld(const u32 (&wd)[NWT]) {
+    constexpr int pos = W * k, wi = WB + pos / 32, bb = pos % 32;
+    u32 v = wd[wi] >> bb; if constexpr (bb + W > 32) v |= wd[wi + 1] << (32 - bb);
+    return v & ((1u << W) - 1u);
+}
+template <int C, int k> struct K1Step {
+    static __device__ __forceinline__ void run(const u32 (&wd)[24], u32 pm, u32 H, int j, const u32 * As, int cs, int16_t * row) {
+        constexpr int W1 = vrW1(C), W2 = vrW2(C), W3 = vrW3(C), S1 = vrSH1(C), S2 = vrSH2(C);
+        u32 f1;
+        if constexpr (W1 == 8) f1 = k1_fld<8, 0, k>(wd); else f1 = k1_fld<W1 - 1, 1, k>(wd) | ((pm >> k) & 1u) << (W1 - 1);
+        const int t = (j + k) & 31; const int h = (H >> t) & 1;
+        const u32 a1 = As[f1], a2 = W2 ? As[k1_fld<(W2 ? W2 : 1), W1, k>(wd)] : 0u, a3 = W3 ? As[k1_fld<(W3 ? W3 : 1), W1 + W2, k>(wd)] : 0u;
+        int16_t * o = row + 4 * t;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            const int ce = h ? (int)(int8_t)(cs >> (8 * e)) : 0;
+            int x = ((int)(int8_t)(a1 >> (8 * e)) + ce) * (1 << S1);
+            if (W2) x += ((int)(int8_t)(a2 >> (8 * e)) + ce) * (1 << S2);
+            if (W3) x += (int)(int8_t)(a3 >> (8 * e)) + ce;
+            o[e] = (int16_t)x;
+        }
+        K1Step<C, k + 1>::run(wd, pm, H, j, As, cs, row);
+    }
+};
+template <int C> struct K1Step<C, 32> { static __device__ __forceinline__ void run(const u32 (&)[24], u32, u32, int, const u32 *, int, int16_t *) {} };
+template <int C> static __device__ __forceinline__ void k1_dec(const u32 * p, int j, const u32 * As, int cs, int16_t * row) {
+    constexpr int NW = vrNW(C), W1 = vrW1(C);
+    u32 wd[24];
+#pragma unroll
+    for (int i = 0; i < 24; ++i) wd[i] = i < NW ? __ldg(p + (i >> 1) * 64 + (i & 1)) : 0u;
+    u32 pm = 0;
+    if constexpr (W1 == 8) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) pm |= (((wd[i] & 0x80808080u) * 0x00204081u) >> 28) << (4 * i);
+    } else pm = wd[0];
+    const u32 H = vr_ung_hk(__funnelshift_l(pm, pm, j), 108);
+    K1Step<C, 0>::run(wd, pm, H, j, As, cs, row);
+}
+static __global__ void __launch_bounds__(64) k_r51_k1(const char * __restrict__ x, char * __restrict__ y, const int rows, const int nb,
+        const half * __restrict__ c16, const short * __restrict__ prm, const int * __restrict__ cp, const unsigned short * __restrict__ cc, const float * __restrict__ cv,
+        const int split = 0) {   // R51 split timing only: 1 = decode phase only, 2 = skip decode (phase 2 on zeros)
+    __shared__ u32 As[256];
+    __shared__ __align__(16) int16_t Ts[32][264];
+    const int b = blockIdx.x, g = blockIdx.y, lane = threadIdx.x & 31, hs = threadIdx.x >> 5;
+    const u32 * A = (const u32 *)x;
