+                clo = vdotq_s32(clo, hm, vreinterpretq_s8_u32(vdupq_n_u32(LH[16 * p + b]))); chi = vdotq_s32(chi, hm, vreinterpretq_s8_u32(vdupq_n_u32(LH[16 * p + 8 + b]))); }
+            VRC_NB(0) VRC_NB(1) VRC_NB(2) VRC_NB(3) VRC_NB(4) VRC_NB(5) VRC_NB(6) VRC_NB(7)
+#undef VRC_NB
+            corr[p][r] = vaddq_s32(clo, vshlq_n_s32(chi, 7));
+        }
+    }
+    int32x4_t acc[2][3][4];
+    for (int p = 0; p < 2; ++p) for (int s = 0; s < 3; ++s) for (int r = 0; r < 4; ++r) acc[p][s][r] = vdupq_n_s32(0);
+    const int8_t * xb = xh + 4 * 16 * lg16;
+    const uint32_t * A = m->A;   // coset-free codebook (int8x4 per entry)
+#pragma GCC unroll 32
+    for (int k = 0; k < 32; ++k) {
+        for (int s = 0; s < nst; ++s) {
+            const int W = s == 0 ? W1 : s == 1 ? W2 : W3, wb = s == 0 ? 0 : s == 1 ? W1 : W1 + W2;
+            for (int r = 0; r < 4; ++r) {
+                uint32_t ix[4];
+                if (W == 8) {   // byte e of word i of lane j: one ldrb each, compile-time offsets from the lane-pair base
+                    const int i = wb + (k >> 2);
+                    const uint8_t * pb = (const uint8_t *)(ph + (i >> 1) * 64 + (i & 1) + 2 * (16 * lg16 + 4 * r)) + (k & 3);
+                    for (int l = 0; l < 4; ++l) ix[l] = pb[8 * l];
+                } else {
+                    const int We = s == 0 ? W - 1 : W, wb2 = s == 0 ? 1 : wb, pos = We * k, wi = wb2 + (pos >> 5), bb = pos & 31;
+                    uint32x4_t v = bb ? vshlq_u32(VRC_LW(wi, r), vdupq_n_s32(-bb)) : VRC_LW(wi, r);
+                    if (bb + We > 32) v = vorrq_u32(v, vshlq_u32(VRC_LW(wi + 1, r), vdupq_n_s32(32 - bb)));
+                    v = vandq_u32(v, vdupq_n_u32((1u << We) - 1u));
+                    if (s == 0) v = vorrq_u32(v, vshlq_u32(vandq_u32(vshlq_u32(VRC_LW(0, r), vdupq_n_s32(-k)), vdupq_n_u32(1)), vdupq_n_s32(We)));
+                    ix[0] = vgetq_lane_u32(v, 0); ix[1] = vgetq_lane_u32(v, 1); ix[2] = vgetq_lane_u32(v, 2); ix[3] = vgetq_lane_u32(v, 3);
+                }
+                // 4-lane "gather": one 32-bit codebook load per lane (= 4 weights)
+                uint32x4_t gv = vld1q_lane_u32(A + ix[0], vdupq_n_u32(0), 0);
+                gv = vld1q_lane_u32(A + ix[1], gv, 1); gv = vld1q_lane_u32(A + ix[2], gv, 2); gv = vld1q_lane_u32(A + ix[3], gv, 3);
