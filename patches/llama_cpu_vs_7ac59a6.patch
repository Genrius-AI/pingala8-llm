+    constexpr bool PAIRG = V == 5 || V == 7;
+    __shared__ __align__(16) int T[V == 1 ? 8192 : PAIRG ? 8192 + 64 : 8192 + 128];
+    const int tid = threadIdx.x, lane = tid & 31, w = tid >> 5;
+    const int s = blockIdx.x % a.nsl, rb = blockIdx.x / a.nsl, b = s >> 1, hs = s & 1;
+    const int g0 = (rb * NWP + w) * RL;
+    u32 wd[RL][24]; int cl[RL];
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int g = g0 + m; cl[m] = 0;
+        if (g < a.ng) {
+            const u32 mt = __ldg(a.M + (size_t)g * a.nb + b); cl[m] = mt >> 29;
+            const uint2 * p = (const uint2 *)(a.D + (mt & 0x1FFFFFFFu));
+            switch (cl[m]) {
+                case 1: vr_load<vrNW(1)>(wd[m], p, hs, lane); break; case 2: vr_load<vrNW(2)>(wd[m], p, hs, lane); break;
+                case 3: vr_load<vrNW(3)>(wd[m], p, hs, lane); break; case 4: vr_load<vrNW(4)>(wd[m], p, hs, lane); break;
+                case 5: vr_load<vrNW(5)>(wd[m], p, hs, lane); break; case 6: vr_load<vrNW(6)>(wd[m], p, hs, lane); break;
+                case 7: vr_load<vrNW(7)>(wd[m], p, hs, lane); break; default: break;
+            }
+        }
+    }
+    {
+        const int x4 = *(const int *)(a.X + (size_t)s * 128 + 4 * lane);
+        if (V >= 3) {
+            if (NWP == 8) {
+#pragma unroll
+                for (int k = 0; k < 32; ++k) { const int e = w * 32 + k; T[e * 32 + lane] = __dp4a((int)c_vrA[e], x4, 0); }
+            } else {
+#pragma unroll 4
+                for (int e = w; e < 256; e += NWP) T[e * 32 + lane] = __dp4a((int)c_vrA[e], x4, 0);
+            }
+            if (PAIRG) {
+                if (tid < 64) { const int j = tid >> 2, m = tid & 3; int g = 0;
+#pragma unroll
+                    for (int q = 0; q < 2; ++q) if ((m >> q) & 1) g += __dp4a((int)c_vrcs, *(const int *)(a.X + (size_t)s * 128 + 4 * (2 * j + q)), 0);
+                    T[8192 + tid] = g; }
+            } else if (tid < 128) { const int j = tid >> 4, m = tid & 15; int g = 0;
+#pragma unroll
+                for (int q = 0; q < 4; ++q) if ((m >> q) & 1) g += __dp4a((int)c_vrcs, *(const int *)(a.X + (size_t)s * 128 + 4 * (4 * j + q)), 0);
+                T[8192 + tid] = g; }
+        } else {
+#pragma unroll
+            for (int k = 0; k < 32; ++k) { const int e = w * 32 + k; T[e * 32 + lane] = (int)__byte_perm((u32)__dp4a((int)c_vrB[e], x4, 0), (u32)__dp4a((int)c_vrA[e], x4, 0), 0x5410); }
+        }
+    }
+    __syncthreads();
+    const float xs = a.XS[s];
+    u32 po[11]; if (V >= 6) vr_po(po, lane); else for (int q = 0; q < 11; ++q) po[q] = 0;
+#pragma unroll
+    for (int m = 0; m < RL; ++m) {
+        const int g = g0 + m;
+        if (g >= a.ng || cl[m] == 0) continue;
+        int acc = 0;
+        switch (cl[m]) {
+            case 1: acc = vr_run<1, V, NS>(wd[m], lane, T, po); break; case 2: acc = vr_run<2, V, NS>(wd[m], lane, T, po); break;
+            case 3: acc = vr_run<3, V, NS>(wd[m], lane, T, po); break; case 4: acc = vr_run<4, V, NS>(wd[m], lane, T, po); break;
+            case 5: acc = vr_run<5, V, NS>(wd[m], lane, T, po); break; case 6: acc = vr_run<6, V, NS>(wd[m], lane, T, po); break;
+            default: acc = vr_run<7, V, NS>(wd[m], lane, T, po); break;
+        }
+        const int r = g * 32 + lane;
+        atomicAdd(a.y + (a.prm ? (int)a.prm[r] : r), (float)acc * xs * __half2float(a.S[(size_t)b * a.rows + r]));   // R51 real: un-permute rows
+    }
+}
