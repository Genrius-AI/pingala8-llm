+            ggml_tensor dt = *dst; dt.data = yt.get(); dt.nb[1] = (size_t)rows * 4; dt.nb[2] = dt.nb[1] * nc; dt.nb[3] = dt.nb[2];
+            ggml_cuda_mul_mat_q(ctx, &t, src1, nullptr, &dt);
+            k_vr_gather<<<dim3((rows + 255) / 256, nc), 256, 0, stream>>>(yt.get(), rows, (const short *)((const char *)src0->data + mmr.offQ), (float *)dst->data, (int)(dst->nb[1] / 4));
+            CUDA_CHECK(cudaGetLastError());
+        } else {
+            t.data = (void *)xin;
+            g_vr_prm = prm_r;
+            ggml_cuda_mul_mat_q(ctx, &t, src1, nullptr, dst);
+            g_vr_prm = nullptr;
+        }
+        if (prof512) r51_ev(3, stream);
+        if (mmr.nd) {   // R51 clamp delta: y += Delta x on the ORIGINAL activation (one launch per matmul in the batch path)
+            const int nc = (int)src1o->ne[1];
+            k_vr_delta_batch<<<(unsigned)(((size_t)mmr.nd * nc + 255) / 256), 256, 0, stream>>>((const unsigned short *)((const char *)src0->data + mmr.offE),
+                (const unsigned short *)((const char *)src0->data + mmr.offE + (size_t)2 * mmr.nd), (const float *)((const char *)src0->data + mmr.offE + (size_t)4 * mmr.nd),
+                mmr.nd, (const float *)src1o->data, (int)(src1o->nb[1] / 4), (float *)dst->data, (int)(dst->nb[1] / 4), nc);
+            CUDA_CHECK(cudaGetLastError());
+        }
+        if (prof512) r51_ev(4, stream);
+        if (f44_check_on()) { vr_native_check(ctx, src0, src1, dst); r51_check(ctx, src0, src1, dst, mode, dq, ws); }
+        return;
+    }
+    if (ggml_cuda_f44_batch_mode() == 2) {   // native MMQ tile loader (decoded straight into the int8 smem tile; F44: IQ2_XS slot, MB: IQ2_S slot)
+        ggml_tensor t = *src0;
+        if (mode == 1) { t.type = GGML_TYPE_IQ2_XS; t.nb[0] = 74; }
+        else           { t.type = GGML_TYPE_IQ2_S;  t.nb[0] = 82; (void)mb_get(src0); }
+        t.nb[1] = t.nb[0] * (K / 256); t.nb[2] = t.nb[1] * rows; t.nb[3] = t.nb[2];
+        static std::once_flag hello2; std::call_once(hello2, [mode] { fprintf(stderr, "%s batch path: native MMQ loader\n", mode == 1 ? "F44" : "MB"); });
+        ggml_cuda_mul_mat_q(ctx, &t, src1, nullptr, dst);
+        if (f44_check_on()) {   // compare against the Q8_0 + MMQ path on the same inputs, once per shape, outside capture
+            static std::map<std::pair<int, int>, int> done; static std::mutex mu;
+            cudaStream_t stream = ctx.stream();
+            cudaStreamCaptureStatus cs; CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+            std::lock_guard<std::mutex> lk(mu);
+            if (cs == cudaStreamCaptureStatusNone && !done[{rows, K}]) {
+                done[{rows, K}] = 1;
+                const size_t n = (size_t)rows * src1->ne[1];
+                ggml_cuda_pool_alloc<char> q8(ctx.pool(), (size_t)rows * (K / 32) * 34);
+                ggml_cuda_pool_alloc<float> y2(ctx.pool(), n);
+                if (mode == 1) k_f44_to_q8<<<(unsigned)(((size_t)rows * (K / 32) + 255) / 256), 256, 0, stream>>>((const uint4 *)src0->data,
+                    (const half *)((const char *)src0->data + (size_t)rows * K / 4), q8.get(), rows, K, F44_LEV4);
+                else k_mb_to_q8<<<(unsigned)(((size_t)rows * (K / 64) + 255) / 256), 256, 0, stream>>>(mb_args_of(src0, mb_get(src0)), q8.get(), rows, K);
+                ggml_tensor tq = *src0; tq.type = GGML_TYPE_Q8_0; tq.data = q8.get();
+                tq.nb[0] = 34; tq.nb[1] = (size_t)34 * (K / 32); tq.nb[2] = tq.nb[1] * rows; tq.nb[3] = tq.nb[2];
+                ggml_tensor d2 = *dst; d2.data = y2.get();
+                ggml_cuda_mul_mat_q(ctx, &tq, src1, nullptr, &d2);
+                std::vector<float> h0(n), h1(n);
+                CUDA_CHECK(cudaMemcpyAsync(h0.data(), dst->data, n * 4, cudaMemcpyDeviceToHost, stream));
+                CUDA_CHECK(cudaMemcpyAsync(h1.data(), y2.get(), n * 4, cudaMemcpyDeviceToHost, stream));
+                CUDA_CHECK(cudaStreamSynchronize(stream));
+                double md = 0, mr = 0; size_t neq = 0;
+                for (size_t i = 0; i < n; ++i) { md = fmax(md, fabs((double)h0[i] - h1[i])); mr = fmax(mr, fabs((double)h1[i])); neq += h0[i] != h1[i]; }
+                fprintf(stderr, "NATIVECHECK mode %d rows %d K %d ne11 %d native_vs_q8mmq maxabsdiff %.3e maxabsref %.3e not_bit_equal %zu of %zu\n",
+                        mode, rows, K, (int)src1->ne[1], md, mr, neq, n);
+            }
+        }
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    const size_t qbytes = (size_t)rows * (K / 32) * 34;
+    ggml_cuda_pool_alloc<char> q8(ctx.pool(), qbytes);
+    mb_args a{};
+    if (mode == 2) {
+        const mb_meta & mm = mb_get(src0); a = mb_args_of(src0, mm);
+        const size_t n = (size_t)rows * (K / 64);
+        k_mb_to_q8<<<(unsigned)((n + 255) / 256), 256, 0, stream>>>(a, q8.get(), rows, K);
+    } else {
+        const size_t n = (size_t)rows * (K / 32);
+        k_f44_to_q8<<<(unsigned)((n + 255) / 256), 256, 0, stream>>>((const uint4 *)src0->data, (const half *)((const char *)src0->data + (size_t)rows * K / 4),
+                                                                    q8.get(), rows, K, F44_LEV4);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    if (f44_check_on()) {
+        static std::map<std::pair<int, int>, int> done; static std::mutex mu;
+        cudaStreamCaptureStatus cs; CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+        std::lock_guard<std::mutex> lk(mu);
+        if (cs == cudaStreamCaptureStatusNone && !done[{rows, K}]) {
+            done[{rows, K}] = 1;
+            unsigned long long * cnt; float * mx; CUDA_CHECK(cudaMallocAsync(&cnt, 3 * 8, stream)); CUDA_CHECK(cudaMallocAsync(&mx, 8, stream));
+            CUDA_CHECK(cudaMemsetAsync(cnt, 0, 24, stream)); CUDA_CHECK(cudaMemsetAsync(mx, 0, 8, stream));
+            const size_t n = (size_t)rows * K;
+            k_q8_check<<<(unsigned)((n + 255) / 256), 256, 0, stream>>>(q8.get(), rows, K, mode, a, (const uint4 *)src0->data,
+                (const half *)((const char *)src0->data + (size_t)rows * K / 4), F44_LEV4, cnt, mx);
+            unsigned long long hc[3]; float hm[2];
+            CUDA_CHECK(cudaMemcpyAsync(hc, cnt, 24, cudaMemcpyDeviceToHost, stream)); CUDA_CHECK(cudaMemcpyAsync(hm, mx, 8, cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream)); CUDA_CHECK(cudaFreeAsync(cnt, stream)); CUDA_CHECK(cudaFreeAsync(mx, stream));
+            fprintf(stderr, "Q8CHECK mode %d rows %d K %d weights %zu | c0-6: nonexact %llu max_rel %.3e | c7: nonexact %llu max_rel %.3e | zero_ref_nonzero %llu\n",
+                    mode, rows, K, n, hc[0], hm[0], hc[1], hm[1], hc[2]);
+        }
+    }
+    ggml_tensor t = *src0;
+    t.type = GGML_TYPE_Q8_0; t.data = q8.get();
+    t.nb[0] = 34; t.nb[1] = (size_t)34 * (K / 32); t.nb[2] = t.nb[1] * rows; t.nb[3] = t.nb[2];
+    static std::once_flag hello; std::call_once(hello, [] { fprintf(stderr, "F44/MB batch path: decode to Q8_0 + MMQ\n"); });
+    ggml_cuda_mul_mat_q(ctx, &t, src1, nullptr, dst);
+}
