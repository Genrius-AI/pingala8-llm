+    if (RL == 1) k_mb<1><<<nrb * a.nsl, 256, 0, stream>>>(a);
+    else if (RL == 2) k_mb<2><<<nrb * a.nsl, 256, 0, stream>>>(a);
+    else k_mb<4><<<nrb * a.nsl, 256, 0, stream>>>(a);
