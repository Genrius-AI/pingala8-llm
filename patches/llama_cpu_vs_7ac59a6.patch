+        std::vector<short> PIV(rows); for (int r = 0; r < rows; ++r) PIV[PRM[r]] = (short)r;
+        CUDA_CHECK(cudaMemcpyAsync(base + mm.offQ, PIV.data(), (size_t)rows * 2, cudaMemcpyHostToDevice, st));
+        CUDA_CHECK(cudaStreamSynchronize(st));
+        vr_init_sgn();
+    }
+    CUDA_CHECK(cudaStreamSynchronize(st));
+    std::lock_guard<std::mutex> lk(g_mb_mu); g_vr[t->data] = mm;
+}
+static const vr_meta & vr_get(const ggml_tensor * src0) {
+    std::lock_guard<std::mutex> lk(g_mb_mu);
+    auto it = g_vr.find(src0->data); GGML_ASSERT(it != g_vr.end() && "VR tensor not prepared");
+    return it->second;
+}
+static int vr_rl(int rows, int K) { static const f44_rlmap r = f44_parse_rl("GGML_VR_RL"); return f44_rl_of(r, rows, K); }
+
+static void vr_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+    GGML_ASSERT(src1->nb[0] == sizeof(float) && ((uintptr_t)src1->data & 15) == 0);
+    const vr_meta & mm = vr_get(src0);
+    const int V = ggml_cuda_f44_mode() == 4 ? 4 : 1;
+    cudaStream_t stream = ctx.stream();
+    const int K = mm.K, rows = mm.rows;
+    ggml_cuda_pool_alloc<int8_t> xq(ctx.pool(), K); ggml_cuda_pool_alloc<float> xs(ctx.pool(), K / 128);
+    if (vr_real()) k_vr_qx_real<<<(K / 256 + 7) / 8, 256, 0, stream>>>((const float *)src1->data, (const half *)((const char *)src0->data + mm.offC), xq.get(), xs.get(), K);
+    else k_mb_qx<<<(K / 128 + 7) / 8, 256, 0, stream>>>((const float *)src1->data, xq.get(), xs.get(), K);
+    float * y = (float *)dst->data;
+    CUDA_CHECK(cudaMemsetAsync(y, 0, (size_t)rows * sizeof(float), stream));
+    const char * base = (const char *)src0->data;
+    vr_args a{(const u32 *)(base + mm.offD), (const u32 *)(base + mm.offM), (const half *)(base + mm.offS), xq.get(), xs.get(), y, rows, K / 128, mm.nb, mm.ng,
+              vr_real() ? (const short *)(base + mm.offP) : nullptr,
+              (const unsigned short *)(base + mm.offE), (const unsigned short *)(base + mm.offE + (size_t)2 * mm.nd), (const float *)(base + mm.offE + (size_t)4 * mm.nd),
+              mm.nd, (const float *)src1->data};
+    const int cv = vrc_v(), nwp = vrc_nwp(), ns = vrc_ns();
+    const int NWP = V == 4 ? nwp : 8;
+    const int RL = vr_rl(rows, K), nrb = (mm.ng + NWP * RL - 1) / (NWP * RL);
+    static std::once_flag hello; std::call_once(hello, [V, cv, nwp, ns] { fprintf(stderr, vr_native_env() ? "VR: %s GEMV hook active (NATIVE file codes) V %d NWP %d NS %d\n" : "VR: %s GEMV hook active (random valid codes) V %d NWP %d NS %d\n", V == 4 ? "VRii-C (coset)" : "VRi (V1)", V == 4 ? cv : 1, V == 4 ? nwp : 8, V == 4 ? ns : 0); });
+    const dim3 grid(nrb * a.nsl);
+    bool ok = true;
+#define VRL(v, nw, s_) { if (RL == 1) k_vr<1, v, nw, s_><<<grid, nw * 32, 0, stream>>>(a); else if (RL == 2) k_vr<2, v, nw, s_><<<grid, nw * 32, 0, stream>>>(a); else k_vr<4, v, nw, s_><<<grid, nw * 32, 0, stream>>>(a); }
+    if (V != 4) VRL(1, 8, 8)
+    else if (cv == 7 && nwp == 8) { if (ns == 4) VRL(7, 8, 4) else if (ns == 16) VRL(7, 8, 16) else if (ns == 116) VRL(7, 8, 116) else if (ns == 108) VRL(7, 8, 108) else if (ns == 104) VRL(7, 8, 104) else if (ns == 8) VRL(7, 8, 8) else ok = false; }
+    else if (cv == 6 && nwp == 12) { if (ns == 4) VRL(6, 12, 4) else if (ns == 16) VRL(6, 12, 16) else if (ns == 116) VRL(6, 12, 116) else if (ns == 108) VRL(6, 12, 108) else if (ns == 8) VRL(6, 12, 8) else ok = false; }
+    else if (cv == 3 && nwp == 8 && ns == 8) VRL(3, 8, 8)
+    else if (cv == 4 && nwp == 8 && ns == 8) VRL(4, 8, 8)
+    else if (cv == 5 && nwp == 8 && ns == 8) VRL(5, 8, 8)
+    else if (cv == 5 && nwp == 8 && ns == 116) VRL(5, 8, 116)
+    else if (cv == 5 && nwp == 8 && ns == 108) VRL(5, 8, 108)
+    else ok = false;
+#undef VRL
+    if (!ok) { fprintf(stderr, "VR: variant V %d NWP %d NS %d not instantiated\n", cv, nwp, ns); GGML_ABORT("VR variant"); }
+    CUDA_CHECK(cudaGetLastError());
+    if (f44_check_on() && !vr_real()) {   // R51: VRCHECK compares unpermuted rows; skipped in real mode (R51CHECK covers it)
+        static std::map<std::pair<int, int>, int> done; static std::mutex mu;
+        cudaStreamCaptureStatus cs; CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+        std::lock_guard<std::mutex> lk(mu);
+        if (cs == cudaStreamCaptureStatusNone && !done[{rows, K}]) {
+            done[{rows, K}] = 1;
+            float * yr; CUDA_CHECK(cudaMallocAsync(&yr, rows * sizeof(float), stream));
+            k_vr_ref<<<rows, 32, 0, stream>>>(base, V, rows, K, xq.get(), xs.get(), yr);
+            std::vector<float> h0(rows), h1(rows);
+            CUDA_CHECK(cudaMemcpyAsync(h0.data(), y, rows * sizeof(float), cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaMemcpyAsync(h1.data(), yr, rows * sizeof(float), cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream)); CUDA_CHECK(cudaFreeAsync(yr, stream));
+            double md = 0, mr = 0; int bad = 0, nonfinite = 0;
+            for (int r = 0; r < rows; ++r) { if (!std::isfinite(h0[r]) || !std::isfinite(h1[r])) ++nonfinite; else mr = fmax(mr, fabs((double)h1[r])); }
+            for (int r = 0; r < rows; ++r) { const double d = fabs((double)h0[r] - h1[r]); if (std::isfinite(d)) { md = fmax(md, d); bad += d > 1e-4 * mr; } }
+            fprintf(stderr, "VRCHECK V %d rows %d K %d RL %d maxabsdiff %.3e maxabsref %.3e rel %.3e rows_over_1e-4_of_max %d nonfinite %d\n",
+                    V, rows, K, RL, md, mr, mr > 0 ? md / mr : 0.0, bad, nonfinite);
+        }
+    }
+}
+
+// GGML_F44_CHECK for the native batch path: MMQ output vs a dense fp32 GEMM with the reference decoder on the same src1
+static void vr_native_check(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (vr_real()) return;   // R51: dense ref uses untransformed src1 and unpermuted rows; R51CHECK covers the real mode
+    const vr_meta & mm = vr_get(src0); const int V = ggml_cuda_f44_mode() == 4 ? 4 : 1;
+    const int K = mm.K, rows = mm.rows, ncols = (int)src1->ne[1];
+    if ((size_t)rows * K > ((size_t)64 << 20) || src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1) return;
+    static std::map<std::pair<int, int>, int> done; static std::mutex mu;
+    cudaStream_t stream = ctx.stream();
+    cudaStreamCaptureStatus cs; CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+    std::lock_guard<std::mutex> lk(mu);
+    if (cs != cudaStreamCaptureStatusNone || done[{rows, K}]) return;
+    done[{rows, K}] = 1;
+    ggml_cuda_pool_alloc<float> W(ctx.pool(), (size_t)rows * K), y2(ctx.pool(), (size_t)rows * ncols);
+    k_vr_decode<<<2048, 256, 0, stream>>>((const char *)src0->data, V, rows, K, W.get());
+    k_dense_ref<<<dim3(rows, ncols), 32, 0, stream>>>(W.get(), (const float *)src1->data, (int)(src1->nb[1] / 4), y2.get(), rows, K, ncols);
+    const size_t n = (size_t)rows * ncols;
+    std::vector<float> h0(n), h1(n);
+    CUDA_CHECK(cudaMemcpyAsync(h0.data(), dst->data, n * 4, cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(h1.data(), y2.get(), n * 4, cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    double md = 0, mr = 0, se = 0, sr = 0; size_t nonfinite = 0;
+    for (size_t i = 0; i < n; ++i) { if (!std::isfinite(h0[i])) { ++nonfinite; continue; } const double d = (double)h0[i] - h1[i]; md = fmax(md, fabs(d)); mr = fmax(mr, fabs((double)h1[i])); se += d * d; sr += (double)h1[i] * h1[i]; }
+    size_t hc[8] = {0}, tt = 0; for (int c = 0; c < 8; ++c) { hc[c] = mm.hist[c]; tt += hc[c]; }
+    fprintf(stderr, "NATIVECHECK_VR V %d rows %d K %d ne11 %d vs dense fp32 ref: maxabsdiff %.3e maxabsref %.3e rel_max %.3e rel_rms %.3e nonfinite %zu share_c4-7 %.4f maxc %d\n",
+            V, rows, K, ncols, md, mr, mr > 0 ? md / mr : 0.0, sr > 0 ? sqrt(se / sr) : 0.0, nonfinite,
+            tt ? (double)(hc[4] + hc[5] + hc[6] + hc[7]) / tt : 0.0, vr_maxc());
+}
diff --git a/ggml/src/ggml-cuda/vr49_dec.h b/ggml/src/ggml-cuda/vr49_dec.h
new file mode 100644
index 0000000..9ca3e14
--- /dev/null
+++ b/ggml/src/ggml-cuda/vr49_dec.h
@@ -0,0 +1,79 @@
+#pragma once
+// R49d: decode one lane-slice (row r = 32g + j, 128-col half-slice) of a class 4-7 VR tile to int8 + one power-of-two shift per
+// 32 columns, with exactly the rounding of the v1 / re-layout MMQ loader (vr47_val in mmq-load-tiles.cuh). Host + device (CPU check).
+// p = lane-slice base (word i at p[(i >> 1) * 64 + (i & 1)]); H = coset word in chunk order (bit t = h of chunk t; 0 for VRi);
+// V = 1 (VRi: stages 2-3 read B) or 4 (VRii-C: all stages read A, + c when h); mw = MSB-word layout for stage 1 (TRL 1).
+// Writes q[t] (4 int8 of chunk t, natural order) and sh[g] (shift of 32-col group g); returns nothing.
+#include <stdint.h>
+#ifndef VR49_HD
+#ifdef __CUDACC__
+#define VR49_HD __host__ __device__ __forceinline__
+#else
+#define VR49_HD inline
+#endif
+#endif
+VR49_HD uint32_t vr49_vadd4(uint32_t a, uint32_t b) {   // bytewise add mod 256 (= __vadd4)
+    uint32_t r = 0; for (int e = 0; e < 4; ++e) r |= ((((a >> (8 * e)) & 0xFFu) + ((b >> (8 * e)) & 0xFFu)) & 0xFFu) << (8 * e); return r;
+}
+VR49_HD int vr49_clz(uint32_t x) { int n = 0; if (!x) return 32; while (!(x & 0x80000000u)) { x <<= 1; ++n; } return n; }
+template <int C>
+VR49_HD void vr49_dec_slice(const uint32_t * p, int j, const uint32_t * A, const uint32_t * B, uint32_t cs, int V, int mw, uint32_t H,
+                            uint32_t (&q)[32], int (&sh)[4]) {
+    constexpr int W1 = 8, W2 = C == 4 ? 2 : C == 5 ? 4 : 8, W3 = C == 7 ? 8 : 0, S1 = C == 4 ? 2 : C == 5 ? 3 : C == 6 ? 2 : 4, S2 = C == 7 ? 2 : 0;   // R51 shift fix
+    constexpr int NW = W1 + W2 + W3;
+    uint32_t w[NW];
+    for (int i = 0; i < NW; ++i) w[i] = p[(i >> 1) * 64 + (i & 1)];
+    auto fld = [&](int wb, int W, int k) -> uint32_t {
+        const int pos = W * k, wi = wb + pos / 32, bb = pos % 32;
+        uint32_t v = w[wi] >> bb; if (bb + W > 32) v |= w[wi + 1] << (32 - bb);
+        return v & ((1u << W) - 1u);
+    };
+    int x[32][4];
+    for (int k = 0; k < 32; ++k) {
+        const int t = (j + k) & 31; const bool h = V == 4 && ((H >> t) & 1u);
+        const uint32_t f1 = mw ? (fld(1, 7, k) | ((w[0] >> k) & 1u) << 7) : fld(0, 8, k);
+        uint32_t a1 = A[f1]; if (h) a1 = vr49_vadd4(a1, cs);
+        uint32_t a2 = V == 4 ? A[fld(W1, W2, k)] : B[fld(W1, W2, k)]; if (h) a2 = vr49_vadd4(a2, cs);
+        uint32_t a3 = 0; if (W3) { a3 = V == 4 ? A[fld(W1 + W2, W3, k)] : B[fld(W1 + W2, W3, k)]; if (h) a3 = vr49_vadd4(a3, cs); }
+        for (int e = 0; e < 4; ++e)
+            x[t][e] = ((int)(int8_t)(a1 >> (8 * e)) * (1 << S1)) + ((int)(int8_t)(a2 >> (8 * e)) * (1 << S2)) + (W3 ? (int)(int8_t)(a3 >> (8 * e)) : 0);
+    }
+    for (int g = 0; g < 4; ++g) {
+        int am = 0; for (int t = 8 * g; t < 8 * g + 8; ++t) for (int e = 0; e < 4; ++e) am = x[t][e] < 0 ? (-x[t][e] > am ? -x[t][e] : am) : (x[t][e] > am ? x[t][e] : am);
+        int s = am > 127 ? 32 - vr49_clz((uint32_t)(am >> 7)) : 0;
+        if (s > 0 && ((am + (1 << (s - 1))) >> s) > 127) ++s;
+        const int hf = s > 0 ? 1 << (s - 1) : 0; sh[g] = s;
+        for (int t = 8 * g; t < 8 * g + 8; ++t) {
+            uint32_t v = 0; for (int e = 0; e < 4; ++e) v |= (uint32_t)(uint8_t)((x[t][e] + hf) >> s) << (8 * e);
+            q[t] = v;
+        }
+    }
+}
+
+// R51c: exact hi/lo int8 planes of a class 4-7 lane-slice: x = hi * 128 + lo, hi = (x + 64) >> 7, lo in [-64, 63] (as vr47_val HL)
+template <int C>
+VR49_HD void vr49_dec_slice_hl(const uint32_t * p, int j, const uint32_t * A, uint32_t cs, int mw, uint32_t H, uint32_t (&qh)[32], uint32_t (&ql)[32]) {
+    constexpr int W1 = 8, W2 = C == 4 ? 2 : C == 5 ? 4 : 8, W3 = C == 7 ? 8 : 0, S1 = C == 4 ? 2 : C == 5 ? 3 : C == 6 ? 2 : 4, S2 = C == 7 ? 2 : 0;
+    constexpr int NW = W1 + W2 + W3;
+    uint32_t w[NW];
+    for (int i = 0; i < NW; ++i) w[i] = p[(i >> 1) * 64 + (i & 1)];
+    auto fld = [&](int wb, int W, int k) -> uint32_t {
+        const int pos = W * k, wi = wb + pos / 32, bb = pos % 32;
+        uint32_t v = w[wi] >> bb; if (bb + W > 32) v |= w[wi + 1] << (32 - bb);
+        return v & ((1u << W) - 1u);
+    };
+    for (int k = 0; k < 32; ++k) {
+        const int t = (j + k) & 31; const bool h = (H >> t) & 1u;
+        const uint32_t f1 = mw ? (fld(1, 7, k) | ((w[0] >> k) & 1u) << 7) : fld(0, 8, k);
+        uint32_t a1 = A[f1]; if (h) a1 = vr49_vadd4(a1, cs);
+        uint32_t a2 = A[fld(W1, W2, k)]; if (h) a2 = vr49_vadd4(a2, cs);
+        uint32_t a3 = 0; if (W3) { a3 = A[fld(W1 + W2, W3, k)]; if (h) a3 = vr49_vadd4(a3, cs); }
+        uint32_t vh = 0, vl = 0;
+        for (int e = 0; e < 4; ++e) {
+            const int x = ((int)(int8_t)(a1 >> (8 * e)) * (1 << S1)) + ((int)(int8_t)(a2 >> (8 * e)) * (1 << S2)) + (W3 ? (int)(int8_t)(a3 >> (8 * e)) : 0);
+            const int hi = (x + 64) >> 7, lo = x - hi * 128;
+            vh |= (uint32_t)(uint8_t)hi << (8 * e); vl |= (uint32_t)(uint8_t)lo << (8 * e);
+        }
+        qh[t] = vh; ql[t] = vl;
+    }
+}
