diff --git a/ggml/src/ggml-cuda/vr49.cuh b/ggml/src/ggml-cuda/vr49.cuh
new file mode 100644
index 0000000..3b826a5
--- /dev/null
+++ b/ggml/src/ggml-cuda/vr49.cuh
@@ -0,0 +1,741 @@
+// R49: VR arms inside llama_f44 (included by f44.cu; research copy only).
+#include "ggml-vr-native.h"   // R51 native VR tensor contract (loader <-> CUDA), transcoder_r51.md
+//   GGML_F44=3 : VRi    (tile-tied VRten, classes 0-7 per 32 rows x 256 cols, no trellis; kernel = k_vr<RL, TR 0, V 1> of
+//                         research/kernels/r47_vr.cu: A|B int16 packed tables, LDS.S16 half by address)
+//   GGML_F44=4 : VRii-C (coset TCVQ: 8-state shift-register trellis on the stage-1 MSB, reset per 128-col half-slice; half h_t
+//                         selects A or A + c for every stage; V4 layout = encode_vr TRL 2: stage-1 index kept whole for W1 = 8,
+//                         MSB word + (W1-1)-bit fields for W1 < 8; int32 A tables + coset subset-sum tables G)
+// Every 2D IQ2_XXS weight is OVERWRITTEN once (before the first graph) with a random VALID VR tensor in the same bytes.
+// In-tensor layout (bytes; fixed offsets so the native MMQ loader in mmq-load-tiles.cuh finds everything from rows and K):
+//   A   256 u32 codebook (int8 x4)                                 at 0
+//   B   256 u32 codebook (VRi stage 2/3; VRii-C: copy of A)        at 1024
+//   CS  u32 coset vector c (int8 x4) + 12 B pad                    at 2048
+//   M   u32 per tile (word offset | class << 29), index g*nb + b   at 2064
+//   S   fp16 per 256 per row, index b*rows + r                     at offS = 2064 + 4 nt
+//   D   payload u32, per tile 2 half-slices x NW(c) words x 32 lanes at offD = align16(offS + 64 nt)
+//       D[off + hs*NW*32 + (i>>1)*64 + j*2 + (i&1)] = word i of lane j; step k of lane j holds chunk t = (j+k)&31.
+
+__host__ __device__ constexpr int vrW1(int c) { return c == 0 ? 0 : c == 1 ? 4 : c == 2 ? 6 : 8; }
+__host__ __device__ constexpr int vrW2(int c) { return c == 4 ? 2 : c == 5 ? 4 : c >= 6 ? 8 : 0; }
+__host__ __device__ constexpr int vrW3(int c) { return c == 7 ? 8 : 0; }
+__host__ __device__ constexpr int vrSH1(int c) { return c == 4 ? 2 : c == 5 ? 3 : c == 6 ? 2 : c == 7 ? 4 : 0; }   // R51: builder shift fix (was 2,4,4,8)
+__host__ __device__ constexpr int vrSH2(int c) { return c == 7 ? 2 : 0; }   // R51: builder shift fix (was 4)
+__host__ __device__ constexpr int vrNW(int c) { return vrW1(c) + vrW2(c) + vrW3(c); }
+static const double VR_RATE[8] = {0, 1, 1.5, 2, 2.5, 3, 4, 6};
+__constant__ u32 c_vrA[256], c_vrB[256], c_vrcs;
+
+struct vr_meta { size_t offM, offS, offD; int rows, K, nb, ng; double bpw; size_t hist[8]; size_t offC = 0, offP = 0, offE = 0, offQ = 0; int nd = 0; size_t n_hl = 0;
+    const int * csr_p = nullptr; const unsigned short * csr_c = nullptr; const float * csr_v = nullptr; };   // R51 PPC: clamp delta as per-original-row CSR   // offQ: inverse prm (original -> sorted), computed at load   // R51 delta: nd entries (row u16, col u16, val fp16) at offE (original indices)   // R51 real: c16 (K fp16) + prm (rows int16) at the tensor end
+static std::map<const void *, vr_meta> g_vr;
+struct vr_args { const u32 * D; const u32 * M; const half * S; const int8_t * X; const float * XS; float * y; int rows, nsl, nb, ng; const short * prm = nullptr;
+    const unsigned short * drow = nullptr; const unsigned short * dcol = nullptr; const float * dval = nullptr; int nd = 0;   /* R51: f32 delta (fp16 is not exact: transcoder_r51.md) */ const float * xraw = nullptr; };
+
+static __device__ __forceinline__ u32 vr_shv(u32 x, int d) { return d >= 0 ? (x << d) : (x >> -d); }
+// field of width W at bit W*k of the word array starting at word WB, returned at bit 7 (= table entry byte offset)
+template <int NWT> static __device__ __forceinline__ u32 vr_fld7(const u32 (&wd)[NWT], int W, int WB, int k) {
+    const int pos = W * k, wi = WB + pos / 32, bb = pos % 32;
+    u32 v;
+    if (bb + W <= 32) v = bb >= 7 ? (wd[wi] >> (bb - 7)) : (wd[wi] << (7 - bb));
+    else v = __funnelshift_r(wd[wi], wd[wi + 1], bb - 7);
+    return v & (((1u << W) - 1u) << 7);
+}
+// Kernel variants (copied from research/kernels/r49_vr.cu, R49_V4_READY):
+//   V 1: VRi (TR 0, LDS.S16, A high half / B low half)
+//   V 3: VRii-C coset, TRL 1 layout (MSB word for all classes), int32 A table, nibble G (128 words)
+//   V 4/5: coset, TRL 2 layout (stage-1 index whole for W1 = 8), nibble G / pair G (64 words)
+//   V 6/7: V 4/5 + PRMT addressing for byte-aligned 8-bit fields (po[] once per thread)
+//   NS = trellis states: 4: h = b1^b2; 8: h = maj(b1,b2,b3); 16: h = maj(b1,b2,b3)^b4 (b_k = stage-1 MSB k chunks back, 0 before the half-slice)
+// po[q] byte i = 8 * ((lane + 3q + i) & 31) (i < 3), byte 3 = 0; PRMT -> (field << 8) | 2 * off, >> 1 -> (field << 7) | off.
+static __device__ __forceinline__ void vr_po(u32 (&po)[11], int lane) {
+#pragma unroll
+    for (int q = 0; q < 11; ++q) { u32 r = 0;
+#pragma unroll
+        for (int i = 0; i < 3; ++i) if (3 * q + i < 32) r |= (u32)(((lane + 3 * q + i) & 31) * 8) << (8 * i);
+        po[q] = r; }
+}
+template <int W, int WB, int k> static __device__ __forceinline__ u32 vr_fprm(const u32 (&wd)[24], const u32 (&po)[11]) {
+    return __byte_perm(wd[WB + k / 4], po[k / 3], (u32)(4 + k % 3) | (u32)(k % 4) << 4 | 0x7700u) >> 1;
+}
+template <int C, int k> static __device__ __forceinline__ int vr_sym_p(const u32 (&wd)[24], const u32 (&po)[11], const int * T) {
+    constexpr int W1 = vrW1(C), W2 = vrW2(C), W3 = vrW3(C), S1 = vrSH1(C), S2 = vrSH2(C);
+    int v = *(const int *)((const char *)T + vr_fprm<8, 0, k>(wd, po)) * (1 << S1);
+    if (W2 == 8) v += *(const int *)((const char *)T + vr_fprm<8, W1, k>(wd, po)) * (1 << S2);
+    else if (W2) v += *(const int *)((const char *)T + (vr_fld7(wd, W2, W1, k) | (po[k / 3] >> (8 * (k % 3)) & 0xffu) >> 1)) * (1 << S2);
+    if (W3) v += *(const int *)((const char *)T + vr_fprm<8, W1 + W2, k>(wd, po));
+    return v;
+}
+template <int C, int k> struct VrLoopP {
+    static __device__ __forceinline__ int run(const u32 (&wd)[24], const u32 (&po)[11], const int * T) {
+        return vr_sym_p<C, k>(wd, po, T) + VrLoopP<C, k + 1>::run(wd, po, T); }
+};
+template <int C> struct VrLoopP<C, 32> {
+    static __device__ __forceinline__ int run(const u32 (&)[24], const u32 (&)[11], const int *) { return 0; }
+};
+// R49 Ungerboeck feedforward labels (NS 104 / 108 / 116 = 4 / 8 / 16 states): z1 = stored stage-1 MSB (chunk order), u recovered by
+// u_t = z1_t ^ u_{t-2} (104), z1_t ^ u_{t-1} ^ u_{t-3} (108), z1_t ^ u_{t-1} ^ u_{t-4} (116), u_{<0} = 0; coset bit h_t = u_{t-1} (104) or u_{t-2}.
+static __device__ __forceinline__ uint32_t vr_ung_hk(uint32_t pc, int ns) {
+    uint32_t u = pc;
+    if (ns == 108) { u ^= (u << 1) ^ (u << 3); u ^= (u << 2) ^ (u << 6); u ^= (u << 4) ^ (u << 12); u ^= (u << 8) ^ (u << 24); u ^= u << 16; return u << 2; }
+    if (ns == 116) { u ^= (u << 1) ^ (u << 4); u ^= (u << 2) ^ (u << 8); u ^= (u << 4) ^ (u << 16); u ^= u << 8; u ^= u << 16; return u << 2; }
+    u ^= u << 2; u ^= u << 4; u ^= u << 8; u ^= u << 16; return u << 1;   // 104
+}
+template <int C, int V, int NS>
+static __device__ __forceinline__ int vr_run(const u32 (&wd)[24], int lane, const int * T, const u32 (&po)[11]) {
+    constexpr int W1 = vrW1(C), W2 = vrW2(C), W3 = vrW3(C), S1 = vrSH1(C), S2 = vrSH2(C);
+    constexpr bool TR = V >= 3, G8 = V >= 4 && W1 == 8;
+    constexpr int W1e = (TR && !G8) ? W1 - 1 : W1, B1 = (TR && !G8) ? 1 : 0;
+    const u32 lane4 = (u32)lane << 2;
+    u32 pm = 0, Hc = 0;
+    if (TR) {
+        if (G8) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) pm |= (((wd[i] & 0x80808080u) * 0x00204081u) >> 28) << (4 * i);
+        } else pm = wd[0];
+        const u32 pc = __funnelshift_l(pm, pm, lane);                    // chunk order
+        u32 H;
+        if (NS >= 100) H = vr_ung_hk(pc, NS);
+        else if (NS == 4) H = (pc << 1) ^ (pc << 2);
+        else {
+            asm("lop3.b32 %0, %1, %2, %3, 0xE8;" : "=r"(H) : "r"(pc << 1), "r"(pc << 2), "r"(pc << 3));
+            if (NS == 16) H ^= pc << 4;
+        }
+        Hc = H;
+    }
+    int acc = 0;
+    if (V >= 6 && G8) acc = VrLoopP<C, 0>::run(wd, po, T);
+    else
+#pragma unroll
+    for (int k = 0; k < 32; ++k) {
+        const u32 off = (lane4 + 4u * k) & 124u;
+        u32 a1 = vr_fld7(wd, W1e, B1, k) | off;
+        if (TR && !G8) a1 |= vr_shv(pm, 7 + W1e - k) & (1u << (7 + W1e));
+        int v;
+        if (TR) {
+            v = *(const int *)((const char *)T + a1) * (1 << S1);
+            if (W2) v += *(const int *)((const char *)T + (vr_fld7(wd, W2, W1, k) | off)) * (1 << S2);
+            if (W3) v += *(const int *)((const char *)T + (vr_fld7(wd, W3, W1 + W2, k) | off));
+        } else {
+            v = (int)*(const short *)((const char *)T + (a1 | 2u)) * (1 << S1);
+            if (W2) v += (int)*(const short *)((const char *)T + (vr_fld7(wd, W2, W1, k) | off)) * (1 << S2);
+            if (W3) v += (int)*(const short *)((const char *)T + (vr_fld7(wd, W3, W1 + W2, k) | off));
+        }
+        acc += v;
+    }
+    if (TR) {                                                            // coset term: Mc * sum_t H_t <c, x_t>
+        constexpr int MC = (1 << S1) + (W2 ? (1 << S2) : 0) + (W3 ? 1 : 0);
+        const int * G = T + 8192; int cs = 0;
+        if (V == 5 || V == 7) {
+#pragma unroll
+            for (int j = 0; j < 16; ++j) cs += G[j * 4 + ((Hc >> (2 * j)) & 3u)];
+        } else {
+#pragma unroll
+            for (int j = 0; j < 8; ++j) cs += G[j * 16 + ((Hc >> (4 * j)) & 15u)];
+        }
+        acc += MC * cs;
+    }
+    return acc;
+}
+template <int NW> static __device__ __forceinline__ void vr_load(u32 (&wd)[24], const uint2 * p, int hs, int lane) {
+    const uint2 * q = p + (size_t)hs * NW * 16 + lane;
+#pragma unroll
+    for (int i = 0; i < NW / 2; ++i) { const uint2 v = __ldcs(q + i * 32); wd[2 * i] = v.x; wd[2 * i + 1] = v.y; }
+}
+template <int RL, int V, int NWP, int NS>
+static __global__ void __launch_bounds__(NWP * 32, 2) k_vr(const vr_args a) {
+    for (int e = blockIdx.x * blockDim.x + threadIdx.x; e < a.nd; e += gridDim.x * blockDim.x)   // R51 clamp delta, fused: y += Delta x (original x, rows)
