+    const int k0 = b * 256 + 8 * lane, sub = lane >> 2;
+    const float4 s0 = __ldg((const float4 *)(g_vr_sgn_d + 8 * lane)), s1 = __ldg((const float4 *)(g_vr_sgn_d + 8 * lane + 4));
+    const float sg[8] = {s0.x, s0.y, s0.z, s0.w, s1.x, s1.y, s1.z, s1.w};
+    const uint4 cw = __ldg((const uint4 *)(c16 + k0)); const half2 * ch = (const half2 *)&cw;
+    float ic[8];
+#pragma unroll
+    for (int m = 0; m < 4; ++m) { const float2 cf = __half22float2(ch[m]); ic[2 * m] = sg[2 * m] / cf.x; ic[2 * m + 1] = sg[2 * m + 1] / cf.y; }
+#pragma unroll 4
+    for (int i = hs; i < 32; i += 2) {   // R51 K1 attempt 2: unroll 4 rows for ILP across the dependent shuffle chain
+        const int r = g * 32 + i;
+        const float sc = __half2float(S[(size_t)b * rows + r]);
