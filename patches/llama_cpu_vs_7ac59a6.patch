+            case 4: vr49_dec_slice<4>(p, j, A, B, cs, V, mw, h, q, sh); break;
+            case 5: vr49_dec_slice<5>(p, j, A, B, cs, V, mw, h, q, sh); break;
+            case 6: vr49_dec_slice<6>(p, j, A, B, cs, V, mw, h, q, sh); break;
