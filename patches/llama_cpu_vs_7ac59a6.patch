+#pragma unroll
+        for (int m = 0; m < 4; ++m) qd[m] = (uint16_t)((uint8_t)(int8_t)__float2int_rn(v[2 * m] * id) | (uint16_t)(uint8_t)(int8_t)__float2int_rn(v[2 * m + 1] * id) << 8);
+    }
+}
+static void r51_to_q8(int mode, const char * x, char * y, int rows, int K, cudaStream_t stream) {
+    const dim3 grid((rows + 127) / 128, K / 256), block(32, 8);
+    const size_t smem = (size_t)128 * ggml_cuda_mmq_get_sram_stride(GGML_CUDA_MMQ_SRAM_LAYOUT_Q8_0) * 4 + 1024;
+    if (mode == 4) k_r51_to_q8<GGML_TYPE_IQ3_S><<<grid, block, smem, stream>>>(x, y, rows, K / 256);
+    else           k_r51_to_q8<GGML_TYPE_IQ3_XXS><<<grid, block, smem, stream>>>(x, y, rows, K / 256);
+    CUDA_CHECK(cudaGetLastError());
+}
+// R51CHECK on blk.1 / blk.16 / blk.35 (every VR tensor of those layers, graphs off): (1) this arm's output vs the R49b re-layout loader
