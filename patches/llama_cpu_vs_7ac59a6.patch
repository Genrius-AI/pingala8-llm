+#elif defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// ---- R53 NEON v4 (phones: armv8.2-a+dotprod). Same algebra as the AVX-VNNI v4 (coset out of the lookup, LH sdot trick on the
+// Pingala-8 h word, x16 planes share one lookup). The 256-entry int8x4 codebook lookup is 4 byte-planes x 4 quarter tables:
+// R53 note: the byte-plane tbl/tbx design needs 64 table registers (4 planes x 16) -> heavy spills (zig a77 asm: 1.38 instr/w);
+// replaced by a 4-lane "gather" of 32-bit codebook loads (ldrb index + ld1 lane), as on x86. Lower register pressure.
+// 16 lanes per call (lane group lg16 = 0, 1), 4 lanes per int32x4.
+#define VRC_V4 1
+static inline __attribute__((always_inline)) void vrc_v4n_half(const int c, const int NP, const uint32_t * ph, int lg16, const vrc_meta * m,
+        const int8_t * xh, size_t xp, const uint32_t * LH, int32x4_t out[2][4]) {
+    const int W1 = vrc_W1(c), W2 = vrc_W2(c), W3 = vrc_W3(c), NW = vrc_NW(c), S1 = vrc_S1(c), S2 = vrc_S2(c), nst = vrc_nst(c), MC = vrc_MC(c);
+    (void)NW;
+    // word i of lanes 16 lg16 + 4r .. +3, loaded on demand (L1-resident payload; keeps register pressure low)
+#define VRC_LW(i, r) (vld2q_u32(ph + ((i) >> 1) * 64 + 2 * (16 * lg16 + 4 * (r))).val[(i) & 1])
+    int32x4_t corr[2][4];
+    for (int r = 0; r < 4; ++r) {
+        uint32x4_t pm;
+        if (W1 == 8) {
+            pm = vdupq_n_u32(0);
+            for (int i = 0; i < 8; ++i) {
+                uint32x4_t nib = vshrq_n_u32(vmulq_u32(vandq_u32(VRC_LW(i, r), vdupq_n_u32(0x80808080u)), vdupq_n_u32(0x00204081u)), 28);
+                pm = vorrq_u32(pm, vshlq_u32(nib, vdupq_n_s32(4 * i)));
+            }
+        } else pm = VRC_LW(0, r);
+        static const int32_t i0123[4] = { 0, 1, 2, 3 };
+        const int32x4_t jv = vaddq_s32(vdupq_n_s32(16 * lg16 + 4 * r), vld1q_s32(i0123));
+        uint32x4_t u = vorrq_u32(vshlq_u32(pm, jv), vshlq_u32(pm, vsubq_s32(jv, vdupq_n_s32(32))));
+#define VRC_NX(a, b) u = veorq_u32(u, veorq_u32(vshlq_n_u32(u, a), vshlq_n_u32(u, b)))
+        VRC_NX(1, 3); VRC_NX(2, 6); VRC_NX(4, 12); VRC_NX(8, 24); u = veorq_u32(u, vshlq_n_u32(u, 16));
+#undef VRC_NX
+        const uint32x4_t hc = vshlq_n_u32(u, 2);
+        for (int p = 0; p < NP; ++p) {
+            int32x4_t clo = vdupq_n_s32(0), chi = vdupq_n_s32(0);
