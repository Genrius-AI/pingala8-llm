+static int f44_check_on() { static const int c = [] { const char * e = getenv("GGML_F44_CHECK"); return e ? atoi(e) : 0; }(); return c; }
+#include "vr49.cuh"   // R49 VR arms (GGML_F44=3 VRi, 4 VRii-C)
+
+// R51 native: does this mul_mat weight carry the R51 trailer (ggml-vr-native.h)? Registers it for ggml_cuda_f44_active. An IQ2_XXS weight
+// without the trailer in native mode means the file is not a native VR file: abort instead of computing garbage.
+static bool vr_native_probe(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    if (!vr_native_slot(t->type) || t->ne[0] % 256 || t->ne[1] % 32 || t->ne[1] > 32767 || t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous(t) || t->view_src) return false;
+    { std::lock_guard<std::mutex> lk(g_vrn_mu); if (g_vr_native_reg.count(t->data)) return true; }
+    uint32_t m[2] = {0, 0};
+    CUDA_CHECK(cudaMemcpyAsync(m, (const char *)t->data + ggml_nbytes(t) - sizeof(vrn_trailer), sizeof(m), cudaMemcpyDeviceToHost, ctx.stream()));
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    const bool ok = m[0] == VRN_MAGIC0 && m[1] == VRN_MAGIC1;
+    if (!ok && t->type == GGML_TYPE_IQ2_XXS) { fprintf(stderr, "VR native: IQ2_XXS weight %s has no R51 trailer (GGML_VR_NATIVE=1 needs the r51 native file)\n", ggml_get_name(t)); GGML_ABORT("VR native"); }
+    if (ok) { std::lock_guard<std::mutex> lk(g_vrn_mu); g_vr_native_reg[t->data] = 1; }
+    return ok;
+}
