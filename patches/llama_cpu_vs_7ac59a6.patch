+// ------------------------------------------------------------------------- independent per-weight reference decoder (bit by bit)
+static __host__ __device__ u32 vr_bits(const u32 * p, int j, int wb, int pos, int W) {   // W bits at bit pos of the word array from word wb, lane j
+    u32 v = 0;
+    for (int q = 0; q < W; ++q) { const int ps = pos + q, wi = wb + ps / 32; v |= ((p[(wi >> 1) * 64 + j * 2 + (wi & 1)] >> (ps % 32)) & 1u) << q; }
+    return v;
+}
+static __host__ __device__ u32 vr_f1(const u32 * p, int j, int c, int V, int trl, int t) {   // stage-1 index of chunk t (layout TRL 1 / 2)
+    const int W1 = vrW1(c), k = (t - j) & 31;
+    if (V == 4 && (trl == 1 || W1 < 8)) return vr_bits(p, j, 1, (W1 - 1) * k, W1 - 1) | vr_bits(p, j, 0, k, 1) << (W1 - 1);
+    return vr_bits(p, j, 0, W1 * k, W1);
+}
+static __host__ __device__ int vr_wint(const char * base, int V, int rows, int nb, int r, int col, int * cls) {
+    const u32 * A = (const u32 *)base; const u32 * B = A + 256; const u32 cs = A[512]; const int ns = (int)A[513], trl = (int)A[514];
+    const size_t nt = (size_t)(rows >> 5) * nb;
+    const u32 * M = (const u32 *)(base + 2064);
+    const u32 * D = (const u32 *)(base + ((2064 + nt * 68 + 15) & ~(size_t)15));
+    const int g = r >> 5, j = r & 31, b = col >> 8, hs = (col >> 7) & 1, t = (col & 127) >> 2, e = col & 3;
+    const u32 mt = M[(size_t)g * nb + b]; const int c = mt >> 29; *cls = c;
+    if (!c) return 0;
+    const int NW = vrNW(c), W1 = vrW1(c), W2 = vrW2(c), W3 = vrW3(c), k = (t - j) & 31;
+    const u32 * p = D + (mt & 0x1FFFFFFFu) + (size_t)hs * NW * 32;
+    const u32 f1 = vr_f1(p, j, c, V, trl, t), f2 = W2 ? vr_bits(p, j, W1, W2 * k, W2) : 0, f3 = W3 ? vr_bits(p, j, W1 + W2, W3 * k, W3) : 0;
+    int h = 0;
+    if (V == 4) {
+        if (ns >= 100) {                                                 // Ungerboeck: recursive u from z1 (independent of the word form)
+            int u[32];
+            for (int q = 0; q < t; ++q) {
+                const int z = (int)((vr_f1(p, j, c, V, trl, q) >> (W1 - 1)) & 1u);
+                auto ug = [&](int i) { return i >= 0 ? u[i] : 0; };
+                u[q] = ns == 108 ? z ^ ug(q - 1) ^ ug(q - 3) : ns == 116 ? z ^ ug(q - 1) ^ ug(q - 4) : z ^ ug(q - 2);
+            }
+            const int d = ns == 104 ? 1 : 2;
+            h = t - d >= 0 ? u[t - d] : 0;
+        } else {
+        int bb[4];
+        for (int q = 1; q <= 4; ++q) bb[q - 1] = t - q >= 0 ? (int)((vr_f1(p, j, c, V, trl, t - q) >> (W1 - 1)) & 1u) : 0;
+        const int mj = (0xE8 >> (bb[0] * 4 + bb[1] * 2 + bb[2])) & 1;
+        h = ns == 4 ? (bb[0] ^ bb[1]) : ns == 16 ? (mj ^ bb[3]) : mj;
+        }
+    }
+    const int ce = (int)(int8_t)(cs >> (8 * e));
+    auto U1 = [&](u32 f) { return (int)(int8_t)(A[f] >> (8 * e)) + (V == 4 && h ? ce : 0); };
+    auto U2 = [&](u32 f) { return V == 4 ? U1(f) : (int)(int8_t)(B[f] >> (8 * e)); };
+    int v = U1(f1) * (1 << vrSH1(c));
+    if (W2) v += U2(f2) * (1 << vrSH2(c));
+    if (W3) v += U2(f3);
+    return v;
+}
+static __host__ __device__ float vr_wscale(const char * base, int rows, int nb, int r, int col) {
+    const size_t nt = (size_t)(rows >> 5) * nb;
+    const half * S = (const half *)(base + 2064 + nt * 4);
+    return __half2float(S[(size_t)(col >> 8) * rows + r]);
+}
+static __global__ void k_vr_ref(const char * base, int V, int rows, int K, const int8_t * X, const float * XS, float * y) {
+    const int r = blockIdx.x, lane = threadIdx.x; float acc = 0.f; int cls;
+    for (int col = lane; col < K; col += 32) acc += (float)vr_wint(base, V, rows, K / 256, r, col, &cls) * vr_wscale(base, rows, K / 256, r, col) * (XS[col >> 7] * (float)X[col]);
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+    if (lane == 0) y[r] = acc;
+}
+static __global__ void k_vr_decode(const char * base, int V, int rows, int K, float * W) {
+    const size_t n = (size_t)rows * K;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (size_t)gridDim.x * blockDim.x) {
+        const int r = (int)(i / K), col = (int)(i % K); int cls;
+        W[i] = (float)vr_wint(base, V, rows, K / 256, r, col, &cls) * vr_wscale(base, rows, K / 256, r, col);
+    }
+}
+static __global__ void k_dense_ref(const float * W, const float * x, int ldx, float * y, int rows, int K, int ncols) {
+    const int r = blockIdx.x, n = blockIdx.y, lane = threadIdx.x; float acc = 0.f;
+    for (int col = lane; col < K; col += 32) acc += W[(size_t)r * K + col] * x[(size_t)n * ldx + col];
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+    if (lane == 0) y[(size_t)n * rows + r] = acc;
+}
