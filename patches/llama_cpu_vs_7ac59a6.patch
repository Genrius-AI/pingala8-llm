diff --git a/ggml/include/ggml-vr-native.h b/ggml/include/ggml-vr-native.h
new file mode 100644
index 0000000..0ee9bbd
--- /dev/null
+++ b/ggml/include/ggml-vr-native.h
@@ -0,0 +1,45 @@
+#pragma once
+// R51 native VR (Pingala-8 Model B) in-memory tensor contract between the llama model loader (src/llama-model-loader.cpp)
+// and the CUDA VR arm (ggml/src/ggml-cuda/vr49.cuh vr_prepare_native). research/agents/transcoder_r51.md.
+//
+// File (gguf-split, r51_native.py):  L.weight I8 [kbytes] = vr49.cuh tensor bytes (A|B|c,NS,TRL,mode | M | S | pad16 | D), sorted rows;
+//   L.vr_prm I16 [rows], L.vr_c F16 [K], L.vr_didx I16 [nd,2] + L.vr_dval F32 [nd] (optional), vr.had_signs I8 [256]; KV vr.ns = 108.
+// Memory (one ggml tensor of logical shape [K, rows], slot type = smallest of VRN_SLOTS with nbytes >= vrn_need()):
+//   [0, kbytes)      kernel bytes, unchanged (M offsets, S at 2064 + 4 nt, D at align16(2064 + 68 nt): vr49.cuh:8-15)
+//   offE             clamp delta: row u16[nd] | col u16[nd] | val f32[nd]   (ORIGINAL row/col indices; y += Delta x)
+//   offC             c16 fp16[K]
+//   offP             prm int16[rows]  (sorted row -> original row)
+//   offQ             pinv int16[rows] (original row -> sorted row; vr49.cuh vr_meta.offQ, k_vr_gather)
+//   offSG            Hadamard signs int8[256] (r48_a1gpu.make_fw seed 0)
+//   offT = n - 32    vrn_trailer
+// All offsets are computed top-down from the tensor end; offE/offC/offP/offQ are 16-byte aligned.
+#include <stddef.h>
+#include <stdint.h>
+
+#define VRN_MAGIC0 0x4E525656u   // "VVRN"
+#define VRN_MAGIC1 0x31354952u   // "RI51"
+#define VRN_NS     108u          // 8 gana states, Ungerboeck ff labels (u = z1 ^ u1 ^ u3, h = u2)
+#define VRN_TRL    2u
+
+struct vrn_trailer { uint32_t magic0, magic1, kbytes, nd, rows, K, ns, version; };   // 32 B
+
+static inline size_t vrn_a16(size_t n) { return (n + 15) & ~(size_t)15; }
+static inline size_t vrn_need(size_t kbytes, size_t rows, size_t K, size_t nd) {
+    return vrn_a16(kbytes) + vrn_a16(8 * nd) + vrn_a16(2 * K) + 2 * vrn_a16(2 * rows) + 256 + 32 + 64;   // + 64: alignment slack of the top-down layout
+}
+static inline void vrn_offsets(size_t n, size_t rows, size_t K, size_t nd, size_t * offE, size_t * offC, size_t * offP, size_t * offQ, size_t * offSG, size_t * offT) {
+    *offT  = n - 32;
+    *offSG = *offT - 256;
+    *offQ  = (*offSG - 2 * rows) & ~(size_t)15;
+    *offP  = (*offQ - 2 * rows) & ~(size_t)15;
+    *offC  = (*offP - 2 * K) & ~(size_t)15;
+    *offE  = (*offC - 8 * nd) & ~(size_t)15;
+}
+// payload words of a VR tensor from its M words (class = M >> 29; NW = W1 + W2 + W3: vr49.cuh:17-22)
+static inline size_t vrn_payload_words(const uint32_t * M, size_t nt) {
+    static const int NW[8] = {0, 4, 6, 8, 10, 12, 16, 24};
+    size_t w = 0; for (size_t i = 0; i < nt; ++i) w += (size_t)64 * NW[M[i] >> 29]; return w;
+}
+static inline size_t vrn_kbytes(size_t rows, size_t K, size_t payload_words) {
+    const size_t nt = (rows / 32) * (K / 256); return ((2064 + 68 * nt + 15) & ~(size_t)15) + 4 * payload_words;
+}
