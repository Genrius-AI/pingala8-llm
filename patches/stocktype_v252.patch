+// Pingala-8 / VR patch: mmq.cuh reuses the MMQ util-func slots of these six stock types for the VR loaders
+// (IQ1_S, IQ3_XXS, IQ3_S, IQ4_XS -> load_tiles_vr47; IQ2_XS -> load_tiles_f44; IQ2_S -> load_tiles_mb47).
+// The VR path calls ggml_cuda_mul_mat_q directly from f44.cu, so the generic dispatch must never send a STOCK
+// tensor of these types to MMQ: it would be decoded with the wrong loader. Route them to MMF/cuBLAS instead
+// (convert.cu keeps the stock dequantizers for these types). MMVQ (batch <= 8) is not patched and stays enabled.
+static bool ggml_cuda_vr_mmq_slot_taken(const ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ4_XS:
+            return true;
+        default:
+            return false;
+    }
+}
